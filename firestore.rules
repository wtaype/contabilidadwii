rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esPersonal() {
      return request.auth != null && 
        get(/databases/$(database)/documents/smiles/$(request.auth.uid)).data.rol in ['personal', 'gestor', 'admin'];
    }

    // 1. Colección Canónica de Usuarios (Clientes, Personal, Gestores, Admin)
    match /smiles/{uid} {
      allow get: if request.auth.uid == uid || esPersonal();
      allow list: if esPersonal() || request.query.limit == 1;
      allow create: if request.auth.uid == uid && request.resource.data.rol == 'cliente';
      allow update: if (request.auth.uid == uid && request.resource.data.rol == resource.data.rol) || esPersonal();
      allow delete: if esPersonal();
    }

    // 2. Artículos y Blog Tributario SEO
    match /entradas/{id} {
      allow read: if true;
      allow write: if esPersonal();
    }

    // 3. Páginas Institucionales y Metadata SEO
    match /paginas/{id} {
      allow read: if true;
      allow write: if esPersonal();
    }

    // 4. Mesa de Ayuda y Consultas SUNAT
    match /soporte/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || esPersonal());
      allow update, delete: if esPersonal();
    }

    // 5. Comprobantes de Pago de Honorarios
    match /comprobantes/{id} {
      allow read, write: if esPersonal();
    }

    // 6. Catálogo de Servicios y Parámetros del Negocio
    match /productos/{id} {
      allow read: if true;
      allow write: if esPersonal();
    }

    match /servicios/{id} {
      allow read: if true;
      allow write: if esPersonal();
    }

    match /negocio/{id} {
      allow read: if true;
      allow write: if esPersonal();
    }

    match /notepad/{id} {
      allow read, write: if esPersonal();
    }

    match /correos/{id} {
      allow read, write: if esPersonal();
    }
  }
}