---
// src/feature/acercas/secciones/04-cookies/componentes/CookiesBanner.astro
// Banner Flotante de Consentimiento Local-First (Estudio Cusihuaman)
// Inspirado en el patrón de alto rendimiento de Workwii · 0ms bloqueo en FCP
import { buildRuta, type Idioma } from '@/core/idioma/idioma';
import es from '../idioma/es.json';
import en from '../idioma/en.json';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? en : es;
const cookiesUrl = buildRuta('/cookies', idioma);
---

<aside 
  class="cookiess" 
  id="cookiess" 
  role="dialog" 
  aria-live="polite" 
  aria-label={t.banner_mensaje} 
  aria-describedby="cookiess-desc"
>
  <p class="cookiess_txt" id="cookiess-desc">
    <i class="fa-solid fa-cookie-bite cookiess_ico" aria-hidden="true"></i>
    <span>{t.banner_mensaje}</span>
    <a href={cookiesUrl} class="cookiess_link">{t.banner_mas_info}</a>
  </p>
  <div class="cookiess_btns">
    <button type="button" class="cookiess_aceptar" id="ck_aceptar">
      <i class="fa-solid fa-check" aria-hidden="true"></i> {t.banner_aceptar}
    </button>
    <button type="button" class="cookiess_rechazar" id="ck_rechazar">
      {t.banner_rechazar}
    </button>
  </div>
</aside>

<style>
  .cookiess {
    position: fixed;
    bottom: 2.5vh;
    right: 2.5vw;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--mbg, rgba(255, 255, 255, 0.95));
    border: 1px solid var(--brd, rgba(0, 0, 0, 0.1));
    border-radius: 1.2rem;
    padding: 1rem 1.4rem;
    box-shadow: 0 12px 35px -6px rgba(0, 0, 0, 0.16), 0 0 1px 1px rgba(0, 0, 0, 0.04);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    max-width: min(92vw, 680px);
    width: max-content;
    transform: translateY(140%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    font-family: var(--ff_P, 'Poppins', sans-serif);
  }

  :global([data-theme="futuro"]) .cookiess {
    background: rgba(18, 24, 38, 0.92);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 35px -6px rgba(0, 0, 0, 0.5);
  }

  .cookiess.cookiess_show {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .cookiess_ico {
    color: var(--mco, #4f46e5);
    font-size: 1.2rem;
    margin-right: 0.35rem;
    flex-shrink: 0;
  }

  .cookiess_txt {
    font-size: 0.85rem;
    color: var(--tx2, #475569);
    margin: 0;
    line-height: 1.5;
    font-weight: 500;
  }

  :global([data-theme="futuro"]) .cookiess_txt {
    color: rgba(255, 255, 255, 0.82);
  }

  .cookiess_link {
    display: inline-flex;
    color: var(--mco, #4f46e5);
    font-weight: 600;
    text-decoration: underline;
    margin-left: 0.3rem;
    transition: color 0.2s ease;
  }

  .cookiess_link:hover {
    color: var(--tx, #0f172a);
  }

  .cookiess_btns {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .cookiess_aceptar,
  .cookiess_rechazar {
    padding: 0.55rem 1.15rem;
    border-radius: 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
  }

  .cookiess_aceptar {
    background: var(--mco, #4f46e5);
    color: #ffffff;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    box-shadow: 0 4px 14px -2px rgba(79, 70, 229, 0.35);
  }

  .cookiess_aceptar:hover {
    transform: scale(1.04);
    opacity: 0.92;
  }

  .cookiess_rechazar {
    background: var(--bg5, rgba(0, 0, 0, 0.05));
    color: var(--tx3, #64748b);
    border: 1px solid var(--brd, rgba(0, 0, 0, 0.1));
  }

  :global([data-theme="futuro"]) .cookiess_rechazar {
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.7);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .cookiess_rechazar:hover {
    background: var(--bg4, rgba(0, 0, 0, 0.09));
    color: var(--tx, #0f172a);
  }

  :global([data-theme="futuro"]) .cookiess_rechazar:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .cookiess {
      left: 3vw;
      right: 3vw;
      bottom: 2vh;
      max-width: 94vw;
      width: auto;
      flex-direction: column;
      align-items: stretch;
      gap: 0.85rem;
      padding: 1.1rem;
    }

    .cookiess_btns {
      width: 100%;
      justify-content: flex-end;
    }

    .cookiess_aceptar,
    .cookiess_rechazar {
      flex: 1;
      justify-content: center;
      text-align: center;
    }
  }
</style>

<script>
  const CK_KEY = 'cookiesPrivacidad';

  const initCookiesBanner = () => {
    const banner = document.getElementById('cookiess');
    if (!banner) return;

    try {
      if (localStorage.getItem(CK_KEY) !== null) {
        banner.remove();
        return;
      }
    } catch (e) {
      banner.remove();
      return;
    }

    // Retardo suave de 800ms para priorizar Core Web Vitals
    setTimeout(() => {
      try {
        if (localStorage.getItem(CK_KEY) !== null) {
          banner.remove();
          return;
        }
      } catch (e) {}
      banner.classList.add('cookiess_show');
    }, 800);
  };

  const handleAction = (val: boolean) => {
    const banner = document.getElementById('cookiess');
    if (!banner) return;
    try {
      localStorage.setItem(CK_KEY, JSON.stringify(val));
    } catch (e) {}
    banner.classList.remove('cookiess_show');
    setTimeout(() => banner.remove(), 400);
  };

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    if (target.closest('#ck_aceptar')) {
      handleAction(true);
    } else if (target.closest('#ck_rechazar')) {
      handleAction(false);
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookiesBanner);
  } else {
    initCookiesBanner();
  }

  document.addEventListener('astro:page-load', initCookiesBanner);
</script>
