---
// src/feature/cliente/components/Header.astro
// Barra superior oficial del Estudio Contable Cusihuaman con branding, buscador, toggle de tema y dropdown de perfil
import { datosNegocio } from '@/negocio.js';

interface Props {
  cliente?: {
    nombre?: string;
    nombreCompleto?: string;
    email?: string;
    avatar?: string;
  };
}

const { cliente = {} } = Astro.props;
---

<header class="cl-topbar">
  <!-- Identidad del Estudio Contable -->
  <a href="/cliente" class="cl-brand">
    <img src="/imgwii/logo.webp" alt={datosNegocio.nombre || 'Estudio Cusihuaman'} class="cl-logo" />
    <div class="cl-brand-info">
      <span class="cl-brand-title">ESTUDIO <span>CUSIHUAMAN</span></span>
      <span class="cl-brand-sub">
        <span class="cl-live-dot"></span> Sede {datosNegocio.direccionSede || 'Jr. Dante 260'} · Asesoría Activa
      </span>
    </div>
  </a>

  <!-- Buscador en Web (Desktop) -->
  <div class="cl-search-box">
    <i class="fa-solid fa-magnifying-glass cl-search-icon"></i>
    <input 
      type="search" 
      id="clSearchInput" 
      class="cl-search-input" 
      placeholder="Buscar servicios contables, asesorías, trámites SUNAT..." 
      autocomplete="off" 
      spellcheck="false" 
      aria-label="Buscar servicios contables"
    />
  </div>

  <!-- Acciones Superiores -->
  <div class="cl-topbar-right">
    <!-- Icono Buscador en Móvil -->
    <button type="button" class="cl-btn-icon cl-btn-search-mobile" id="btnSearchMobile" title="Buscar servicios" aria-label="Abrir buscador">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>

    <!-- Alternar Tema -->
    <button type="button" class="cl-btn-icon" id="btnThemeToggle" title="Alternar tema" aria-label="Alternar tema">
      <i class="fa-solid fa-moon"></i>
    </button>

    <!-- Ver Web Principal -->
    <a href="/" target="_blank" class="cl-btn-icon" title="Ver Web Principal" aria-label="Ver Web Principal">
      <i class="fa-solid fa-arrow-up-right-from-square"></i>
    </a>

    <!-- Dropdown de Usuario / Contribuyente Autenticado -->
    <div class="cl-user-dropdown-container">
      <button type="button" class="cl-user-chip-btn" id="btnUserChip" aria-expanded="false" aria-haspopup="true">
        <div class="cl-avatar-sm" id="topbarAvatarLetter">{cliente.avatar ? cliente.nombre?.charAt(0).toUpperCase() : 'C'}</div>
        <div class="cl-user-meta">
          <span class="cl-user-name" id="topbarUserName">{cliente.nombre || 'Contribuyente'}</span>
          <span class="cl-user-badge" id="topbarUserPlan">Contribuyente</span>
        </div>
        <i class="fa-solid fa-chevron-down cl-chevron"></i>
      </button>

      <!-- Menú Desplegable -->
      <div class="cl-dropdown-menu" id="menuUserDropdown">
        <div class="cl-dd-header">
          <div class="cl-dd-user" id="dropdownUserFullName">{cliente.nombreCompleto || cliente.nombre || 'Mi Perfil'}</div>
          <div class="cl-dd-mail" id="dropdownUserEmail">{cliente.email || ''}</div>
        </div>
        <a href="/" target="_blank" class="cl-dd-item destacado">
          <i class="fa-solid fa-house"></i> <span>Ver Web Principal</span>
        </a>
        <button type="button" class="cl-dd-item" data-jump-to="pedidos">
          <i class="fa-solid fa-briefcase"></i> <span>Servicios y Asesorías</span>
        </button>
        <button type="button" class="cl-dd-item" data-jump-to="direccion">
          <i class="fa-solid fa-building"></i> <span>Domicilio Fiscal</span>
        </button>
        <button type="button" class="cl-dd-item" data-jump-to="cuenta">
          <i class="fa-solid fa-id-card"></i> <span>Mi Perfil Tributario</span>
        </button>
        <button type="button" class="cl-dd-item" data-jump-to="soporte">
          <i class="fa-solid fa-headset"></i> <span>Consultas SUNAT</span>
        </button>
        <div class="cl-dd-divider"></div>
        <button type="button" class="cl-dd-item danger" id="btnLogoutSession">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> <span>Cerrar Sesión</span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Barra de Búsqueda Desplegable en Móvil -->
<div class="cl-mobile-search-bar" id="mobileSearchBar">
  <div class="cl-mobile-search-bar-inner">
    <i class="fa-solid fa-magnifying-glass cl-mobile-search-icon"></i>
    <input 
      type="search" 
      id="clSearchInputMobile" 
      placeholder="Buscar servicios o trámites..." 
      autocomplete="off" 
      spellcheck="false" 
      aria-label="Buscar servicios móvil"
    />
  </div>
  <button type="button" class="cl-btn-close-search" id="btnCloseMobileSearch" title="Cerrar búsqueda" aria-label="Cerrar búsqueda">
    <i class="fa-solid fa-xmark"></i>
  </button>
</div>
