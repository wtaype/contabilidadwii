---
// src/feature/cliente/modulos/01-pedidos/Pedidos.astro
// Módulo de Servicios y Asesorías Tributarias · Estudio Cusihuaman
// 100% Conectado a Firestore (datosNegocio.productos, datosNegocio.mediosPago)
// Cero datos de gas · Split Layout con WhatsApp Live Preview
import { datosNegocio, MEDIOS_PAGO_BASE } from '@/negocio.js';

import type { SmileData, SmileDireccion } from '@/core/tipos/auth.ts';

interface Props {
  cliente?: SmileData;
}

const { cliente = {} } = Astro.props;

interface DireccionPedido {
  id: string;
  alias: string;
  calle: string;
  distrito: string;
  celular?: string;
  referencia?: string;
  eta?: string;
  esPrincipal?: boolean;
}

// Normalizar direcciones reales (Soporta Map de Firestore o Array de smiles/{uid})
let listaDirecciones: DireccionPedido[] = [];
if (Array.isArray(cliente.direcciones)) {
  listaDirecciones = (cliente.direcciones as SmileDireccion[]).map((d, idx) => ({
    id: String(d.id || `dir-${idx}`),
    alias: d.alias || d.etiqueta || (idx === 0 ? 'Domicilio Fiscal' : `Sede ${idx + 1}`),
    calle: d.calle || d.direccion || '',
    distrito: d.distrito || 'Surquillo',
    celular: d.celular || cliente.celular || cliente.telefono || '',
    referencia: d.referencia || '',
    eta: d.eta || '',
    esPrincipal: Boolean(d.esPrincipal ?? d.predeterminada ?? (idx === 0))
  })).filter(d => Boolean(d.calle));
} else if (cliente.direcciones && typeof cliente.direcciones === 'object') {
  listaDirecciones = Object.entries(cliente.direcciones as Record<string, any>).map(([key, d]) => ({
    id: key,
    alias: d.alias || d.etiqueta || (key === 'principal' ? 'Domicilio Fiscal' : key),
    calle: d.calle || d.direccion || '',
    distrito: d.distrito || 'Surquillo',
    celular: d.celular || cliente.celular || cliente.telefono || '',
    referencia: d.referencia || '',
    eta: d.eta || '',
    esPrincipal: key === 'principal' || Boolean(d.esPrincipal ?? d.predeterminada)
  })).filter(d => Boolean(d.calle));
}

// Catálogo Oficial Vivo desde Firestore (datosNegocio.productos)
const prodsRaw = datosNegocio.productos || [];
const prodsFiltrados = prodsRaw
  .filter(p => p.estado !== 'pausado' && p.estado !== 'inactivo')
  .sort((a, b) => (a.orden || 999) - (b.orden || 999));

// Fallback canónico de seguridad tributaria si Firestore no devolvió registros en build
const productosCatalogo = prodsFiltrados.length > 0 ? prodsFiltrados.map((p, idx) => ({
  id: p.id || `prod-${idx}`,
  nombre: typeof p.nombre === 'object' ? (p.nombre.es || 'Servicio Contable') : (p.nombre || 'Servicio Contable'),
  nombreCorto: typeof p.nombre === 'object' ? (p.nombre.es || 'Servicio') : (p.nombreCorto || p.nombre || 'Servicio'),
  badge: p.badge || (idx === 0 ? 'MÁS SOLICITADO' : (p.tipo === 'asesoria' ? 'ASESORÍA 1 A 1' : 'MENSUAL')),
  tagClase: p.tagClase || (idx === 0 ? 'badge-fire' : 'badge-blue'),
  precioPEN: Number(p.precioPEN ?? (p.precio ?? 0)),
  imagen: p.imagen || '/imgwii/productos/orientacion.webp',
  valvula: p.modalidad || 'Online vía Meet y Presencial Surquillo',
  balanza: (Array.isArray(p.caracteristicas) && p.caracteristicas.length > 0) 
    ? p.caracteristicas[0] 
    : (p.enfoque || 'Atención personalizada por CPC Lourdes Cusihuaman'),
  defaultQty: idx === 0 ? 1 : 0
})) : [
  {
    id: 'serv-mype',
    nombre: 'Declaración Mensual & Contabilidad MYPE',
    nombreCorto: 'Contabilidad MYPE',
    badge: 'MÁS SOLICITADO',
    tagClase: 'badge-fire',
    precioPEN: 150.00,
    imagen: '/imgwii/productos/mype.webp',
    valvula: 'Mensual · SIRE, IGV/Renta y Planilla',
    balanza: 'Evita multas y fiscalizaciones de SUNAT',
    defaultQty: 1
  },
  {
    id: 'serv-rer',
    nombre: 'Régimen Especial de Renta (RER) y SIRE',
    nombreCorto: 'Régimen RER',
    badge: 'MYPE / RER',
    tagClase: 'badge-blue',
    precioPEN: 100.00,
    imagen: '/imgwii/productos/rer.webp',
    valvula: 'Mensual · Compras, Ventas y Formulario 621',
    balanza: 'Para pequeños comercios y servicios',
    defaultQty: 0
  },
  {
    id: 'asesoria-1a1',
    nombre: 'Asesoría Tributaria Personalizada (1 Hora)',
    nombreCorto: 'Asesoría 1 a 1',
    badge: 'ASESORÍA 1 A 1',
    tagClase: 'badge-gold',
    precioPEN: 80.00,
    imagen: '/imgwii/productos/orientacion.webp',
    valvula: 'Videollamada Google Meet o Presencial Surquillo',
    balanza: 'Resolución de dudas tributarias específicas',
    defaultQty: 0
  },
  {
    id: 'asesoria-urgente',
    nombre: 'Diagnóstico & Levantamiento de Esquelas SUNAT',
    nombreCorto: 'Esquelas SUNAT',
    badge: 'URGENTE',
    tagClase: 'badge-fire',
    precioPEN: 120.00,
    imagen: '/imgwii/productos/orientacion.webp',
    valvula: 'Revisión urgente de Buzón SOL y descargos',
    balanza: 'Subsanación antes del cierre de plazo',
    defaultQty: 0
  }
];

const mediosPagoLista = datosNegocio.mediosPago || MEDIOS_PAGO_BASE;
const telefonoSede = datosNegocio.telefonoLimpio || '987594558';
const whatsappSede = datosNegocio.whatsapp || '51987594558';
---

<div class="cl-pedidos-module" id="moduloPedidos">
  <div class="cl-grid-split">
    
    <!-- COLUMNA IZQUIERDA: SERVICIOS Y ASESORÍAS -->
    <div class="cl-col-left">
      
      <!-- BANNER DE BIENVENIDA -->
      <div class="cl-prods-header">
        <div class="cl-welcome-row">
          <div class="cl-welcome-title">
            <span id="clWelcomeSalute">¡Hola!</span> ⚖️ <strong class="cl-text-orange">Servicios y Asesorías Contables</strong>
          </div>
          <button type="button" class="cl-btn-ficha" id="btnGestionarFicha" title="Gestionar ficha de contribuyente">
            <i class="fa-solid fa-id-card"></i> <span>Mi Ficha Fiscal</span>
          </button>
        </div>

        <div class="cl-sub-legend-row">
          <span class="cl-legend-left">SELECCIONA TUS SERVICIOS O ASESORÍA</span>
          <span class="cl-legend-right"><i class="fa-solid fa-scale-balanced"></i> ATENCIÓN DIRECTA POR CPC COLEGIADA</span>
        </div>
      </div>

      <!-- LISTA DE PRODUCTOS HORIZONTALES (DINÁMICOS DE FIRESTORE) -->
      <div class="cl-prods-list" id="listaProductosCards">
        {productosCatalogo.map((prod) => (
          <div 
            class={`cl-h-card ${prod.defaultQty > 0 ? 'has-items' : ''}`} 
            data-id={prod.id} 
            data-nombre={prod.nombre} 
            data-nombrecorto={prod.nombreCorto} 
            data-precio={prod.precioPEN}
          >
            <div class="cl-h-img-box">
              <img src={prod.imagen} alt={prod.nombre} class="cl-h-img" loading="lazy" />
            </div>

            <div class="cl-h-info">
              <div class="cl-h-badge-row">
                {prod.badge && <span class={`cl-h-badge ${prod.tagClase}`}>{prod.badge}</span>}
                <span class="cl-h-title">{prod.nombre}</span>
              </div>
              <div class="cl-h-checks">
                <span><i class="fa-solid fa-check"></i> {prod.valvula}</span>
                <span><i class="fa-solid fa-check"></i> {prod.balanza}</span>
              </div>
            </div>

            <div class="cl-h-action-col">
              <div class="cl-h-price" id={`priceDisplay-${prod.id}`}>S/ {prod.precioPEN.toFixed(2)}</div>
              
              <!-- STEPPER DE CANTIDAD -->
              <div class="cl-qty-stepper">
                <button type="button" class="cl-btn-qty btn-minus" data-id={prod.id} title="Quitar">
                  <i class="fa-solid fa-minus"></i>
                </button>
                <span class="cl-qty-val" id={`qty-${prod.id}`}>{prod.defaultQty}</span>
                <button type="button" class="cl-btn-qty btn-plus" data-id={prod.id} title="Agregar">
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- COLUMNA DERECHA: PAGO Y CONTACTO DIRECTO POR WHATSAPP -->
    <div class="cl-col-right">
      
      <!-- CARD: MODALIDAD Y PAGO -->
      <div class="cl-order-card">
        
        <!-- HEADER DE LA TARJETA -->
        <div class="cl-card-header">
          <span class="cl-card-title">
            <i class="fa-solid fa-wallet"></i> MODALIDAD & COORDINACIÓN
          </span>
          <span class="cl-certificada-badge">
            CPC Certificada <i class="fa-solid fa-circle-check"></i>
          </span>
        </div>

        <!-- 1. DIRECCIÓN FISCAL {SELECT} + BOTÓN AGREGAR -->
        <div class="cl-dir-picker-row">
          <div class="cl-dir-label">
            <i class="fa-solid fa-building"></i>
            <span>Ubicación:</span>
          </div>
          <select class="cl-sel-dir" id="selDireccionPedido">
            {listaDirecciones.length > 0 ? (
              listaDirecciones.map(d => (
                <option 
                  value={d.id} 
                  data-calle={d.calle} 
                  data-distrito={d.distrito} 
                  data-celular={d.celular || cliente.celular || ''} 
                  data-ref={d.referencia} 
                  selected={d.esPrincipal}
                >
                  {d.alias} — {d.calle}, {d.distrito}
                </option>
              ))
            ) : (
              <option value="" disabled selected data-calle="" data-distrito="" data-celular="">
                Atención 100% Online Nacional / Sede Surquillo
              </option>
            )}
          </select>
          <button type="button" class="cl-btn-add-dir" id="btnAddDirJump" title="Gestionar domicilio fiscal">
            <i class="fa-solid fa-plus"></i> <span>Agregar</span>
          </button>
        </div>

        <!-- 1.1 TELÉFONO / CELULAR DE CONTACTO -->
        <div class="cl-contact-picker-row" id="clContactPickerRow">
          <div class="cl-contact-label">
            <i class="fa-solid fa-phone"></i>
            <span>WhatsApp:</span>
          </div>
          <div class="cl-contact-input-wrap">
            <input 
              type="tel" 
              class="cl-input-contact" 
              id="inCelularPedido" 
              placeholder="Número de WhatsApp para coordinar..." 
              value={cliente.celular || ''} 
            />
          </div>
        </div>

        <!-- 2. BOTONES DE PAGO (DESDE FIRESTORE) -->
        <div class="cl-pay-grid" id="payMethodsGrid">
          {mediosPagoLista.map((mp, idx) => (
            <button 
              type="button" 
              class={`cl-pay-opt ${idx === 0 ? 'active' : ''}`} 
              data-method={mp.nombre}
            >
              <i class={`fa-solid ${mp.icon || 'fa-money-bill-wave'}`}></i>
              <span>{mp.nombre}</span>
            </button>
          ))}
        </div>

        <!-- 3. NOTA: {TEXTAREA} -->
        <div class="cl-notes-block">
          <label class="cl-notes-label" for="inNotasPedido">
            <i class="fa-solid fa-pen-to-square"></i> Consulta o RUC:
          </label>
          <textarea 
            class="cl-notes-textarea" 
            id="inNotasPedido" 
            placeholder="Indica tu RUC o describe brevemente tu caso o duda tributaria..."
          ></textarea>
        </div>

      </div>

      <!-- MOCKUP WHATSAPP REALISTA -->
      <div class="cl-wa-box">
        <div class="cl-wa-header">
          <div class="cl-wa-header-left">
            <img src="/imgwii/logo.webp" alt="Estudio Cusihuaman" class="cl-wa-avatar" />
            <div>
              <strong style="font-size:0.84rem;">CPC Lourdes Cusihuaman</strong>
              <small style="font-size:0.68rem; opacity:0.9; display:block;">Asesoría Contable en línea · Sede Surquillo</small>
            </div>
          </div>
          <i class="fa-solid fa-phone" style="font-size:0.85rem;"></i>
        </div>

        <div class="cl-wa-body">
          <div class="cl-bubble-out" id="bubbleWaPedido">
            <!-- Mensaje dinámico renderizado por pedidos.js -->
            <div class="cl-wa-time"><span>11:00 a. m.</span> <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i></div>
          </div>
        </div>

        <div class="cl-summary-box">
          <div>
            <div class="cl-summary-prod" id="sumItemsCount">1 servicio seleccionado</div>
            <div class="cl-summary-sub" id="sumDirSelected">Atención Online / Presencial</div>
          </div>
          <div class="cl-summary-price" id="sumPriceTotal">S/ 150.00</div>
        </div>

        <div class="cl-actions-row">
          <a href={`tel:${telefonoSede}`} class="cl-btn-call" title="Llamar al Estudio"><i class="fa-solid fa-phone"></i></a>
          <a href={`https://wa.me/${whatsappSede}`} target="_blank" rel="noopener noreferrer" class="cl-btn-wa-order" id="btnWaOrder">
            <i class="fa-brands fa-whatsapp"></i> <span id="lblBtnWaOrder">Solicitar por WhatsApp</span>
          </a>
        </div>
      </div>

    </div>

  </div>

  <!-- BARRA RESUMEN FLOTANTE EN MÓVIL (ENCIMA DEL BOTTOM DOCK) -->
  <div class="cl-mobile-cart-bar">
    <div class="cl-m-cart-left">
      <span class="cl-m-cart-count" id="mCartCount">1 servicio</span>
      <span class="cl-m-cart-total" id="mCartTotal">S/ 150.00</span>
    </div>
    <a href={`https://wa.me/${whatsappSede}`} target="_blank" rel="noopener noreferrer" class="cl-m-cart-btn-wa" id="mBtnWaOrder">
      <i class="fa-brands fa-whatsapp"></i> <span>Solicitar ahora</span>
    </a>
  </div>
</div>
