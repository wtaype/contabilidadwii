---
// src/feature/cliente/modulos/03-cuenta/Cuenta.astro
// Módulo de Ficha del Contribuyente, Perfil Fiscal, Facturación SUNAT, Seguridad y Preferencias
// Diseño 100% consistente con 02-direccion · Split Layout 2 Columnas · Tokens witema.css
interface Props {
  cliente?: any;
}
const { cliente = {} } = Astro.props;
---

<div class="cl-cuenta-module" id="moduloCuenta">
  <!-- 1. ENCABEZADO DEL MÓDULO CON IDENTIDAD DEL CLIENTE -->
  <div class="ct-panel-head">
    <div class="ct-head-left">
      <div class="ct-panel-title">
        <i class="fa-solid fa-id-card"></i>
        <span>Mi Ficha Fiscal y Cuenta del Contribuyente</span>
      </div>
      <span class="ct-panel-subtitle">
        Administra tus datos fiscales, número de RUC/DNI, clave de acceso y preferencias de asesoría tributaria.
      </span>
    </div>

    <!-- CHIP COMPACTO DE IDENTIDAD (0ms Local-First) -->
    <div class="ct-head-identity">
      <div class="ct-avatar-pill" id="ctAvatarLetter">
        <i class="fa-solid fa-user-tie"></i>
      </div>
      <div class="ct-identity-meta">
        <span class="ct-identity-name" id="ctHeroNombre">Contribuyente</span>
        <span class="ct-handle-chip" id="ctHeroUsuario">@cargando</span>
      </div>
      <div class="ct-puntos-badge">
        <i class="fa-solid fa-shield-halved" style="font-size:0.7rem;"></i>
        <span id="ctPuntosNum">Habido</span>
      </div>
    </div>
  </div>

  <!-- 2. LAYOUT SPLIT: 2 COLUMNAS (50% / 50%) APROVECHANDO 100% DEL ESPACIO -->
  <div class="ct-layout-split">
    <!-- ========================================================
         COLUMNA IZQUIERDA: DATOS PERSONALES & FACTURACIÓN SUNAT
         ======================================================== -->
    <div class="ct-card-editor">
      <div class="ct-card-header">
        <div class="ct-card-title">
          <i class="fa-solid fa-id-card"></i>
          <span>Datos de la Cuenta & Identificación SUNAT</span>
        </div>
      </div>

      <form id="formCuentaPerfil" autocomplete="off">
        <!-- Fila 1: Usuario de acceso permanente & Correo -->
        <div class="ct-form-row">
          <div class="ct-form-group">
            <label class="ct-form-label" for="ctInputUsuario">
              <i class="fa-solid fa-at"></i> Usuario de Acceso (Permanente):
            </label>
            <input 
              type="text" 
              class="ct-input" 
              id="ctInputUsuario" 
              readonly 
              disabled 
              title="Tu identificador único de usuario no es modificable"
            />
          </div>

          <div class="ct-form-group">
            <label class="ct-form-label" for="ctInputEmail">
              <i class="fa-solid fa-envelope"></i> Correo Electrónico:
            </label>
            <input 
              type="email" 
              class="ct-input" 
              id="ctInputEmail" 
              readonly 
              disabled 
            />
          </div>
        </div>

        <!-- Fila 2: Nombres y Apellidos / Razón Social -->
        <div class="ct-form-row">
          <div class="ct-form-group">
            <label class="ct-form-label" for="ctInputNombre">
              <i class="fa-solid fa-user"></i> Nombres / Titular:
            </label>
            <input 
              type="text" 
              class="ct-input" 
              id="ctInputNombre" 
              placeholder="Tu nombre completo" 
              required 
            />
          </div>

          <div class="ct-form-group">
            <label class="ct-form-label" for="ctInputApellidos">
              <i class="fa-regular fa-user"></i> Apellidos / Razón Social:
            </label>
            <input 
              type="text" 
              class="ct-input" 
              id="ctInputApellidos" 
              placeholder="Tus apellidos o empresa" 
            />
          </div>
        </div>

        <!-- Fila 3: Avatar e Iniciales de Identidad (Personalizables) -->
        <div class="ct-form-row">
          <div class="ct-form-group">
            <label class="ct-form-label" for="ctInputAvatar">
              <i class="fa-solid fa-image"></i> Avatar (URL de Imagen):
            </label>
            <input 
              type="text" 
              class="ct-input" 
              id="ctInputAvatar" 
              placeholder="https://imgwii.web.app/smile.avif" 
            />
            <div class="ct-sug-row">
              <button type="button" class="ct-sug-chip" data-avatar-sug="https://imgwii.web.app/smile.avif">
                <i class="fa-solid fa-circle-check" style="color:var(--cl-orange);"></i> Avatar Oficial (/smile.avif)
              </button>
              <button type="button" class="ct-sug-chip" data-avatar-sug="https://api.dicebear.com/7.x/bottts/svg?seed=Cusihuaman">
                <i class="fa-solid fa-user-tie"></i> Avatar Profesional
              </button>
            </div>
          </div>

          <div class="ct-form-group">
            <label class="ct-form-label" for="ctInputIniciales">
              <i class="fa-solid fa-font"></i> Iniciales de Identidad:
            </label>
            <input 
              type="text" 
              class="ct-input" 
              id="ctInputIniciales" 
              placeholder="Ej: LC" 
              maxlength="3" 
              style="text-transform: uppercase; font-weight: 700;" 
            />
            <div class="ct-sug-row">
              <button type="button" class="ct-sug-chip" id="btnAutoIniciales">
                <i class="fa-solid fa-arrows-rotate"></i> Auto-generar
              </button>
            </div>
          </div>
        </div>

        <!-- Fila 4: Celular / WhatsApp de Coordinación -->
        <div class="ct-form-group">
          <label class="ct-form-label" for="ctInputCelular">
            <i class="fa-brands fa-whatsapp" style="color:#22c55e;"></i> WhatsApp de Notificaciones Tributarias:
          </label>
          <input 
            type="tel" 
            class="ct-input" 
            id="ctInputCelular" 
            placeholder="Ej: 987 594 558" 
          />
        </div>

        <!-- SECCIÓN SUNAT: COMPROBANTES ELECTRÓNICOS -->
        <div class="ct-sunat-divider">
          <i class="fa-solid fa-file-invoice"></i>
          <span>Datos Tributarios y de Facturación (SUNAT)</span>
        </div>

        <div class="ct-form-row">
          <div class="ct-form-group">
            <label class="ct-form-label" for="ctSelectDocTipo">
              <i class="fa-solid fa-passport"></i> Tipo de Documento:
            </label>
            <select class="ct-select" id="ctSelectDocTipo">
              <option value="RUC">RUC (Factura / MYPE)</option>
              <option value="DNI">DNI (Boleta / Honorarios)</option>
              <option value="CE">Carnet de Extranjería</option>
              <option value="PASAPORTE">Pasaporte</option>
            </select>
          </div>

          <div class="ct-form-group">
            <label class="ct-form-label" for="ctInputDocumento">
              <i class="fa-solid fa-hashtag"></i> Número de Documento (RUC / DNI):
            </label>
            <input 
              type="text" 
              class="ct-input" 
              id="ctInputDocumento" 
              placeholder="Ej: 20601234567 o 10456789123" 
              maxlength="15" 
            />
          </div>
        </div>

        <!-- Campos condicionales para RUC -->
        <div class="ct-form-row" id="ctRucCampos" style="display:none;">
          <div class="ct-form-group">
            <label class="ct-form-label" for="ctInputRazonSocial">
              <i class="fa-solid fa-building"></i> Razón Social:
            </label>
            <input 
              type="text" 
              class="ct-input" 
              id="ctInputRazonSocial" 
              placeholder="Ej: Mi Empresa S.A.C." 
            />
          </div>

          <div class="ct-form-group">
            <label class="ct-form-label" for="ctInputDireccionFiscal">
              <i class="fa-solid fa-location-dot"></i> Dirección Fiscal:
            </label>
            <input 
              type="text" 
              class="ct-input" 
              id="ctInputDireccionFiscal" 
              placeholder="Dirección fiscal declarada en SUNAT" 
            />
          </div>
        </div>

        <!-- Botón de Guardar Datos -->
        <div class="ct-form-actions">
          <button type="submit" class="ct-btn-save" id="btnGuardarPerfil">
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Guardar Mis Datos</span>
          </button>
        </div>
      </form>
    </div>

    <!-- ========================================================
         COLUMNA DERECHA: SEGURIDAD (ARRIBA) + PREFERENCIAS TRIBUTARIAS (ABAJO)
         ======================================================== -->
    <div class="ct-right-col">
      <!-- TARJETA 1 (ARRIBA): SEGURIDAD Y ACCESO -->
      <div class="ct-card-section">
        <div class="ct-card-header">
          <div class="ct-card-title">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Seguridad & Clave de Acceso</span>
          </div>
        </div>

        <form id="formCuentaPassword" autocomplete="off">
          <div class="ct-form-row">
            <div class="ct-form-group">
              <label class="ct-form-label" for="ctInputNuevaPass">
                <i class="fa-solid fa-key"></i> Nueva Contraseña:
              </label>
              <input 
                type="password" 
                class="ct-input" 
                id="ctInputNuevaPass" 
                placeholder="Mínimo 6 caracteres" 
                minlength="6" 
                required 
              />
            </div>

            <div class="ct-form-group">
              <label class="ct-form-label" for="ctInputConfirmarPass">
                <i class="fa-solid fa-check-double"></i> Confirmar Contraseña:
              </label>
              <input 
                type="password" 
                class="ct-input" 
                id="ctInputConfirmarPass" 
                placeholder="Repite la contraseña" 
                minlength="6" 
                required 
              />
            </div>
          </div>

          <div class="ct-form-actions">
            <button type="submit" class="ct-btn-save" id="btnCambiarPass">
              <i class="fa-solid fa-key"></i>
              <span>Actualizar Clave</span>
            </button>
            <button type="button" class="ct-btn-secondary" id="btnEnviarResetMail">
              <i class="fa-solid fa-envelope"></i>
              <span>Restablecer por Correo</span>
            </button>
          </div>
        </form>
      </div>

      <!-- TARJETA 2 (ABAJO): PERFIL TRIBUTARIO Y ALERTAS -->
      <div class="ct-card-section">
        <div class="ct-card-header">
          <div class="ct-card-title">
            <i class="fa-solid fa-sliders"></i>
            <span>Perfil Tributario & Preferencias de Atención</span>
          </div>
        </div>

        <form id="formCuentaPreferencias">
          <!-- Fila 1: Régimen Tributario & Modalidad habitual -->
          <div class="ct-form-row">
            <div class="ct-form-group">
              <label class="ct-form-label" for="ctSelectValvula">
                <i class="fa-solid fa-scale-balanced"></i> Régimen Tributario Actual:
              </label>
              <select class="ct-select" id="ctSelectValvula">
                <option value="mype">Régimen MYPE Tributario (RMT)</option>
                <option value="rer">Régimen Especial de Renta (RER)</option>
                <option value="general">Régimen General (RG)</option>
                <option value="rus">Nuevo RUS (NRUS)</option>
                <option value="cuarta">4ta Categoría (Recibos por Honorarios)</option>
              </select>
            </div>

            <div class="ct-form-group">
              <label class="ct-form-label" for="ctSelectHorario">
                <i class="fa-solid fa-clock"></i> Modalidad de Contacto Preferida:
              </label>
              <select class="ct-select" id="ctSelectHorario">
                <option value="online-tarde">Online (Meet / WhatsApp) · Tardes</option>
                <option value="online-manana">Online (Meet / WhatsApp) · Mañanas</option>
                <option value="presencial-surquillo">Presencial Sede Surquillo (Previa Cita)</option>
              </select>
            </div>
          </div>

          <!-- Fila 2: Método de pago & Giro Comercial -->
          <div class="ct-form-row">
            <div class="ct-form-group">
              <label class="ct-form-label" for="ctSelectMetodoPago">
                <i class="fa-solid fa-wallet"></i> Medio de Pago Habitual:
              </label>
              <select class="ct-select" id="ctSelectMetodoPago">
                <option value="bcp">Transferencia Bancaria BCP</option>
                <option value="yape">Yape / Plin</option>
                <option value="efectivo">Efectivo en Sede Surquillo</option>
              </select>
            </div>

            <div class="ct-form-group">
              <label class="ct-form-label" for="ctInputPisoAscensor">
                <i class="fa-solid fa-briefcase"></i> Actividad o Giro Comercial:
              </label>
              <input 
                type="text" 
                class="ct-input" 
                id="ctInputPisoAscensor" 
                placeholder="Ej: Servicios de TI, Restaurante, Consultoría..." 
              />
            </div>
          </div>

          <!-- Fila 3: Switches de Notificaciones Tributarias -->
          <div class="ct-apple-row">
            <label class="ct-apple-card" for="ctSwitchTimbre">
              <div class="ct-apple-card-info">
                <span class="ct-apple-title">
                  <i class="fa-solid fa-calendar-check ct-bell-icon"></i> Alerta de Vencimiento
                </span>
                <span class="ct-apple-desc">Avisar según último dígito de RUC</span>
              </div>
              <div class="ct-apple-switch">
                <input type="checkbox" id="ctSwitchTimbre" checked />
                <span class="ct-slider"></span>
              </div>
            </label>

            <label class="ct-apple-card" for="ctSwitchLlamar">
              <div class="ct-apple-card-info">
                <span class="ct-apple-title">
                  <i class="fa-solid fa-envelope-open-text ct-phone-icon"></i> Alerta Buzón SOL
                </span>
                <span class="ct-apple-desc">Avisarme ante esquelas SUNAT</span>
              </div>
              <div class="ct-apple-switch">
                <input type="checkbox" id="ctSwitchLlamar" checked />
                <span class="ct-slider"></span>
              </div>
            </label>
          </div>

          <label class="ct-apple-card" for="ctSwitchComprobante" style="margin-block: 0.6vh;">
            <div class="ct-apple-card-info">
              <span class="ct-apple-title">
                <i class="fa-solid fa-file-pdf ct-receipt-icon"></i> Copia de Liquidación por Correo
              </span>
              <span class="ct-apple-desc">Recibe automáticamente el detalle de IGV/Renta y comprobante en tu email</span>
            </div>
            <div class="ct-apple-switch">
              <input type="checkbox" id="ctSwitchComprobante" checked />
              <span class="ct-slider"></span>
            </div>
          </label>

          <div class="ct-form-actions">
            <button type="submit" class="ct-btn-save" id="btnGuardarPreferencias">
              <i class="fa-solid fa-sliders"></i>
              <span>Guardar Preferencias</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
