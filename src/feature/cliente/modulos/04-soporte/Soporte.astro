---
// src/feature/cliente/modulos/04-soporte/Soporte.astro
// Módulo de Consultas SUNAT y Mesa de Ayuda Contable · Estudio Cusihuaman
// 100% Humano, Smart, Split Layout 2 Columnas · Tokens witema.css
import { datosNegocio } from '@/negocio.js';

interface Props {
  cliente?: any;
}
const { cliente = {} } = Astro.props;
const whatsappSede = datosNegocio.whatsapp || '51987594558';
const telefonoSede = datosNegocio.telefonoLimpio || '987594558';
---

<div class="cl-soporte-module" id="moduloSoporte">
  <!-- 1. ENCABEZADO DEL MÓDULO CON BADGE DE ATENCIÓN ACTIVA -->
  <div class="sp-panel-head">
    <div class="sp-head-left">
      <div class="sp-panel-title">
        <i class="fa-solid fa-headset"></i>
        <span>Consultas Tributarias & Mesa de Ayuda SUNAT</span>
      </div>
      <span class="sp-panel-subtitle">
        Canal directo con la CPC Lourdes Cusihuaman Gálvez para resolver dudas sobre tus declaraciones mensuales, esquelas o trámites fiscales.
      </span>
    </div>

    <!-- BADGE DE ATENCIÓN EN VIVO -->
    <div class="sp-head-badge">
      <span class="sp-live-dot"></span>
      <span>Sede Surquillo & Online Nacional · Atención Activa</span>
    </div>
  </div>

  <!-- 2. LAYOUT SPLIT: 2 COLUMNAS (50% / 50%) APROVECHANDO 100% DEL ESPACIO -->
  <div class="sp-layout-split">
    <!-- ========================================================
         COLUMNA IZQUIERDA: FORMULARIO DE CONSULTA TRIBUTARIA
         ======================================================== -->
    <div class="sp-card-editor">
      <div class="sp-card-header">
        <div class="sp-card-title">
          <i class="fa-solid fa-paper-plane"></i>
          <span>Enviar Consulta a la Contadora</span>
        </div>
      </div>

      <form id="formSoporteTicket" autocomplete="off">
        <!-- Fila 1: Tipo de Consulta con wiSelect -->
        <div class="sp-form-group">
          <label class="sp-form-label" for="spSelectTipo">
            <i class="fa-solid fa-circle-question"></i> Motivo de tu Consulta Tributaria:
          </label>
          <select class="sp-select" id="spSelectTipo">
            <option value="declaracion">Declaración Mensual IGV / Renta (Formulario 621 / SIRE)</option>
            <option value="esquela">Esquela de Citación / Inconsistencia SUNAT (Urgente)</option>
            <option value="honorarios">Recibo por Honorarios y Suspensión de 4ta Categoría</option>
            <option value="comprobante">Comprobante de Pago de Honorarios (Boleta / Factura)</option>
            <option value="cotizacion">Presupuesto para Contabilidad Mensual de Negocio (MYPE)</option>
            <option value="otro">Otra consulta contable, tributaria o laboral</option>
          </select>
        </div>

        <!-- Fila Contextual Comprobante SUNAT (Condicional) -->
        <div class="sp-form-row" id="spCamposComprobante" style="display:none;">
          <div class="sp-form-group">
            <label class="sp-form-label" for="spSelectTipoComp">
              <i class="fa-solid fa-receipt"></i> Tipo de Comprobante:
            </label>
            <select class="sp-select" id="spSelectTipoComp">
              <option value="factura">Factura de Honorarios (RUC)</option>
              <option value="boleta">Boleta de Venta / Honorarios (DNI)</option>
            </select>
          </div>

          <div class="sp-form-group">
            <label class="sp-form-label" for="spInputDocComp" id="spLabelDocComp">
              <i class="fa-solid fa-hashtag"></i> N° de Documento (RUC/DNI):
            </label>
            <input 
              type="text" 
              class="sp-input" 
              id="spInputDocComp" 
              placeholder="Ingresa tu RUC o DNI" 
              maxlength="11" 
            />
          </div>
        </div>

        <div class="sp-form-group" id="spGrupoRazonSocial" style="display:none;">
          <label class="sp-form-label" for="spInputRazonComp">
            <i class="fa-solid fa-building"></i> Razón Social de la Empresa:
          </label>
          <input 
            type="text" 
            class="sp-input" 
            id="spInputRazonComp" 
            placeholder="Ej: Mi Empresa S.A.C." 
          />
        </div>

        <!-- Fila Contextual Cotización MYPE (Condicional) -->
        <div class="sp-form-row" id="spCamposCotizacion" style="display:none;">
          <div class="sp-form-group">
            <label class="sp-form-label" for="spSelectTipoNegocio">
              <i class="fa-solid fa-briefcase"></i> Giro o Rubro Comercial:
            </label>
            <select class="sp-select" id="spSelectTipoNegocio">
              <option value="comercio">Comercio / Venta de productos físicos</option>
              <option value="servicios">Servicios profesionales / Consultoría / Software</option>
              <option value="restaurante">Restaurante / Alimentos</option>
              <option value="construccion">Construcción / Contratista</option>
              <option value="otro">Otro rubro comercial</option>
            </select>
          </div>

          <div class="sp-form-group">
            <label class="sp-form-label" for="spSelectBalonCotiz">
              <i class="fa-solid fa-scale-balanced"></i> Régimen Tributario Estimado:
            </label>
            <select class="sp-select" id="spSelectBalonCotiz">
              <option value="mype">Régimen MYPE Tributario (RMT)</option>
              <option value="rer">Régimen Especial de Renta (RER)</option>
              <option value="general">Régimen General</option>
              <option value="persona">Persona Natural con Negocio (RUC 10)</option>
            </select>
          </div>
        </div>

        <!-- Fila Mensaje Detallado -->
        <div class="sp-form-group">
          <label class="sp-form-label" for="spTextareaDetalle">
            <i class="fa-solid fa-comment-dots"></i> Detalle de tu consulta o requerimiento:
          </label>
          <textarea 
            class="sp-textarea" 
            id="spTextareaDetalle" 
            placeholder="Describe tu caso con total confianza: número de RUC, plazo límite o duda sobre tus impuestos..." 
            required 
            style="min-height: 120px;"
          ></textarea>
        </div>

        <!-- Botón de Envío -->
        <div class="sp-form-actions">
          <button type="submit" class="sp-btn-save" id="btnEnviarTicket">
            <i class="fa-solid fa-paper-plane"></i>
            <span>Enviar Consulta a CPC Lourdes Cusihuaman</span>
          </button>
        </div>
      </form>
    </div>

    <!-- ========================================================
         COLUMNA DERECHA: CANALES DIRECTOS (ARRIBA) + HISTORIAL (ABAJO)
         ======================================================== -->
    <div class="sp-right-col">
      <!-- TARJETA 1 (ARRIBA): CANALES DE ATENCIÓN DIRECTA -->
      <div class="sp-card-section">
        <div class="sp-card-header">
          <div class="sp-card-title">
            <i class="fa-solid fa-phone-volume"></i>
            <span>Canales Directos de Atención</span>
          </div>
        </div>

        <div class="sp-channels-grid">
          <a href={`tel:${telefonoSede}`} class="sp-channel-card">
            <div class="sp-channel-head">
              <i class="fa-solid fa-phone" style="color:var(--cl-orange);"></i>
              <span>Teléfono del Estudio</span>
            </div>
            <span class="sp-channel-desc">Horario de oficina</span>
            <span class="sp-channel-val">987 594 558</span>
          </a>

          <a href={`https://wa.me/${whatsappSede}`} target="_blank" rel="noopener noreferrer" class="sp-channel-card">
            <div class="sp-channel-head">
              <i class="fa-brands fa-whatsapp" style="color:#22c55e;"></i>
              <span>WhatsApp Directo</span>
            </div>
            <span class="sp-channel-desc">Consultas y citas rápidas</span>
            <span class="sp-channel-val">+51 987 594 558</span>
          </a>
        </div>

        <div style="font-size:0.75rem; color:var(--muted); line-height:1.4; display:flex; align-items:center; gap:8px;">
          <i class="fa-solid fa-certificate" style="color:var(--cl-emerald); font-size:0.9rem;"></i>
          <span><strong>Garantía Profesional Colegiada:</strong> Atención confidencial por CPC Lourdes Cusihuaman Gálvez, ex-funcionaria de SUNAT con Matrícula Oficial.</span>
        </div>

        <!-- Botón Directo WhatsApp Oficial con mensaje prellenado inteligente -->
        <a 
          href={`https://wa.me/${whatsappSede}?text=${encodeURIComponent('Hola CPC Lourdes Cusihuaman, deseo realizar una consulta tributaria.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="sp-btn-wa-full"
          id="spBtnWhatsApp"
        >
          <i class="fa-brands fa-whatsapp" style="font-size:1.15rem;"></i>
          <span>Escribir directamente por WhatsApp</span>
        </a>
      </div>

      <!-- TARJETA 2 (ABAJO): MIS CONSULTAS RECIENTES -->
      <div class="sp-card-section">
        <div class="sp-card-header">
          <div class="sp-card-title">
            <i class="fa-solid fa-clock-rotate-left"></i>
            <span>Mis Consultas y Casos Registrados</span>
          </div>
          <span class="cd-badge-count" id="spBadgeTicketsCount">0</span>
        </div>

        <div class="sp-tickets-scroll" id="listaTicketsRecientes">
          <div class="sp-empty-tickets" id="spEmptyTickets">
            <i class="fa-solid fa-folder-open"></i>
            <span>Aún no has enviado consultas. Cuando envíes un requerimiento o trámite, aparecerá aquí con su estado de atención.</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
