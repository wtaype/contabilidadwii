---
// src/feature/inicio/secciones/06-compania/Compania.astro
// 6. SECCIÓN ACOMPAÑAMIENTO TERAPÉUTICO Y METODOLOGÍA EN 3 PASOS
import { datosNegocio } from '../../../../negocio.js';
import { resolverIdioma } from '../../idioma/idioma.js';
import es from './idioma/es.json';
import en from './idioma/en.json';
import companiaCss from './compania.css?inline';

interface Props {
  idioma?: string;
}

const { idioma = Astro.props.idioma || Astro.currentLocale || 'es' } = Astro.props;
const t = resolverIdioma({ es, en }, idioma);

const wsLink = `https://wa.me/${datosNegocio.whatsappLimpio}?text=${encodeURIComponent(t.ws_msg)}`;
---

<style is:global set:html={companiaCss}></style>

<section id="metodologia" class="sec-seguridad section-py-body">
  <div class="pagewii">
    <div class="seguridad-split items-center">
      
      <!-- Columna Izquierda: Información de Metodología y Pasos -->
      <div>
        <span class="badge-serenidad seguridad-badge">
          <i class="fa-solid fa-scale-balanced"></i> 
          <span>{t.badge.toUpperCase()}</span>
        </span>

        <h2 class="seguridad-title">{t.titulo}</h2>
        <p class="seguridad-desc">{t.descripcion}</p>

        <!-- 3 Pasos con Iconos Contables -->
        <ul class="seguridad-steps-list">
          <li class="seguridad-step-item">
            <div class="seguridad-icon-box orange" style="background: rgba(197, 168, 128, 0.15); color: #c5a880; border: 1px solid rgba(197, 168, 128, 0.3);">
              <i class="fa-solid fa-magnifying-glass-chart"></i>
            </div>
            <div class="seguridad-step-content">
              <h3>{t.paso_1_titulo}</h3>
              <p>{t.paso_1_desc}</p>
            </div>
          </li>

          <li class="seguridad-step-item">
            <div class="seguridad-icon-box blue" style="background: rgba(11, 34, 57, 0.5); color: #f3e5c8; border: 1px solid rgba(197, 168, 128, 0.25);">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div class="seguridad-step-content">
              <h3>{t.paso_2_titulo}</h3>
              <p>{t.paso_2_desc}</p>
            </div>
          </li>

          <li class="seguridad-step-item">
            <div class="seguridad-icon-box emerald" style="background: rgba(37, 211, 102, 0.12); color: #25d366; border: 1px solid rgba(37, 211, 102, 0.25);">
              <i class="fa-solid fa-file-circle-check"></i>
            </div>
            <div class="seguridad-step-content">
              <h3>{t.paso_3_titulo}</h3>
              <p>{t.paso_3_desc}</p>
            </div>
          </li>
        </ul>

        <!-- Botón de Inicio por WhatsApp -->
        <a 
          href={wsLink} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-whatsapp btn-seguridad-cta"
          title={t.btn_pedir}
          style="background: #25d366; color:#fff; font-weight: 700; border-radius: 1vh; box-shadow: 0 0.8vh 2.2vh rgba(37, 211, 102, 0.35);"
        >
          <i class="fa-brands fa-whatsapp"></i> 
          <span>{t.btn_pedir}</span>
        </a>
      </div>

      <!-- Columna Derecha: Tarjeta Fotográfica con Badge -->
      <div>
        <div class="seguridad-image-card">
          <div class="seguridad-media-box">
            <img 
              src="/imgwii/Attorney_reviewing_documents.jpeg" 
              alt="Asesoría tributaria profesional - Estudio Cusihuaman" 
              width="500" 
              height="400" 
              loading="lazy"
              decoding="async" 
              class="seguridad-media-img"
            />
            <div class="seguridad-caption-card">
              <span class="seguridad-caption-pill">
                <i class="fa-solid fa-circle-check"></i> 
                <span>{t.foto_badge}</span>
              </span>
              <span class="seguridad-caption-header">{t.foto_titulo}</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
