---
// src/feature/personal/modulos/clientes/Clientes.astro
// Módulo de Clientes: Directorio CRM Contable & Tributario (Estudio Cusihuaman)
// 100% JS Nativo · Integrado con @widev, Firestore ('clientes') · 0 CSS Inline

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-clientes" data-clientes-init="false">
  
  <!-- CABECERA SUPERIOR STICKY -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-address-book sn-header-icon" style="color: var(--brand-primary, var(--mco, #9e7b4f));"></i>
        Clientes · Cartera Contable & Tributaria
      </h1>
      <p class="ps-section-sub">
        Gestión centralizada de contribuyentes MYPE, RER y 4ta Categoría con monitoreo de vencimientos SUNAT y contacto directo.
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-primary" id="btnNuevoCliente">
        <i class="fa-solid fa-user-plus"></i> Registrar Cliente Contable
      </button>
    </div>
  </div>

  <!-- KPIS SUPERIORES -->
  <div class="cl-kpi-grid">
    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap">
        <i class="fa-solid fa-briefcase"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiTotal">0</span>
        <span class="cl-kpi-lbl">Total Clientes en Cartera</span>
      </div>
    </div>

    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap cl-kpi-icon-vip">
        <i class="fa-solid fa-building"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiMype">0</span>
        <span class="cl-kpi-lbl">Empresas MYPE / General</span>
      </div>
    </div>

    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap cl-kpi-icon-green">
        <i class="fa-solid fa-user-tie"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiIndependientes">0</span>
        <span class="cl-kpi-lbl">Independientes 4ta Cat (RHE)</span>
      </div>
    </div>

    <div class="cl-kpi-card">
      <div class="cl-kpi-icon-wrap cl-kpi-icon-blue">
        <i class="fa-solid fa-coins"></i>
      </div>
      <div class="cl-kpi-data">
        <span class="cl-kpi-val" id="clKpiFacturacion">S/ 0.00</span>
        <span class="cl-kpi-lbl">Honorarios Mensuales Cartera</span>
      </div>
    </div>
  </div>

  <!-- LAYOUT DIVIDIDO (DIRECTORIO 62% / FICHA CRM 38%) -->
  <div class="cl-split-layout">
    
    <!-- COLUMNA 1: TABLA DEL DIRECTORIO -->
    <div class="cl-card">
      <div class="cl-toolbar">
        <div class="cl-filters-wrap" id="clFiltersWrap">
          <button type="button" class="cl-filter-pill active" data-filter="todos">Todos</button>
          <button type="button" class="cl-filter-pill" data-filter="mype">MYPE Tributario</button>
          <button type="button" class="cl-filter-pill" data-filter="independiente">4ta Cat (RHE)</button>
          <button type="button" class="cl-filter-pill" data-filter="rer">RER</button>
        </div>

        <div class="cl-search-box">
          <i class="fa-solid fa-magnifying-glass cl-search-icon"></i>
          <input 
            type="text" 
            id="clSearchInput" 
            class="cl-search-input" 
            placeholder="Buscar por RUC, razón social o celular..." 
            autocomplete="off" 
          />
        </div>
      </div>

      <div class="cl-table-responsive">
        <table class="cl-table">
          <thead>
            <tr>
              <th>Contribuyente / RUC</th>
              <th>Celular</th>
              <th>Régimen Tributario</th>
              <th class="sn-text-center">Dígito</th>
              <th class="sn-text-right">Honorario</th>
              <th class="sn-text-right">Acción</th>
            </tr>
          </thead>
          <tbody id="clTableBody">
            <!-- Renderizado dinámico desde clientes.js -->
          </tbody>
        </table>
      </div>
    </div>

    <!-- COLUMNA 2: FICHA CRM INTERACTIVA (EN VIVO) -->
    <div class="cl-crm-wrap">
      <div class="cl-crm-card">
        <div class="cl-crm-head">
          <div class="cl-crm-avatar-box" id="clCrmAvatarBox">
            <span id="clCrmAvatarLetter">E</span>
          </div>
          <div class="cl-crm-info-head">
            <h2 class="cl-crm-title" id="clCrmNombre">Cargando...</h2>
            <p class="cl-crm-subtitle" id="clCrmDoc">RUC: -</p>
          </div>
        </div>

        <div class="cl-crm-stats">
          <div class="cl-crm-stat-box">
            <span class="cl-crm-stat-val" id="clCrmRegimen">MYPE Tributario</span>
            <span class="cl-crm-stat-lbl">Régimen Fiscal</span>
          </div>
          <div class="cl-crm-stat-box">
            <span class="cl-crm-stat-val" id="clCrmHonorario">S/ 0.00</span>
            <span class="cl-crm-stat-lbl">Honorario Mensual</span>
          </div>
        </div>

        <div class="cl-crm-section-title">
          <i class="fa-solid fa-file-invoice"></i> Información Tributaria & Servicio
        </div>

        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Servicio:</span>
          <span id="clCrmServicio" style="font-weight:600;">Contabilidad Mensual</span>
        </div>
        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Último Dígito RUC:</span>
          <span id="clCrmDigitoRuc" style="font-weight:700; color:var(--brand-primary, var(--mco, #9e7b4f)); font-size:14px;">-</span>
        </div>
        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Estado Fiscal:</span>
          <span id="clCrmEstadoFiscal" class="cl-status-tag al-dia">Al Día</span>
        </div>
        <div class="cl-crm-detail-row">
          <span class="cl-crm-detail-lbl">Cliente desde:</span>
          <span id="clCrmFechaInicio">Ene 2026</span>
        </div>

        <div class="cl-crm-section-title sn-mt-14">
          <i class="fa-solid fa-map-location-dot"></i> Dirección Fiscal & Contacto
        </div>

        <div class="cl-crm-address-box">
          <div class="cl-crm-address-title">
            <span id="clCrmDireccion">Jr. Dante 260, Surquillo</span>
          </div>
          <div class="cl-crm-address-sub" id="clCrmContacto">Contacto: -</div>
          <div class="cl-crm-address-sub" id="clCrmObservaciones" style="font-style: italic; margin-top:4px;">Sin observaciones</div>
        </div>

        <div class="cl-crm-actions">
          <button type="button" class="cl-crm-btn cl-crm-btn-ws" id="btnCrmWs">
            <i class="fa-brands fa-whatsapp"></i> Recordar Vencimiento por WhatsApp
          </button>
          <button type="button" class="cl-crm-btn cl-crm-btn-call" id="btnCrmCall">
            <i class="fa-solid fa-phone"></i> Llamar al Celular
          </button>
          <button type="button" class="cl-crm-btn cl-crm-btn-sunat" id="btnCrmSunat">
            <i class="fa-solid fa-receipt"></i> Emitir Recibo / Factura
          </button>
        </div>
      </div>
    </div>

  </div>

  <!-- MODAL: REGISTRAR NUEVO CLIENTE CONTABLE -->
  <div class="cl-modal-overlay" id="clModalOverlay">
    <div class="cl-modal">
      <div class="cl-modal-head">
        <h3 class="cl-modal-title">
          <i class="fa-solid fa-user-plus sn-title-icon"></i> Nuevo Cliente Contable
        </h3>
        <button type="button" class="cl-modal-close" id="btnModalClose">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="formModalCliente" class="cl-modal-form">
        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="clModalDocTipo">Tipo Documento</label>
            <select id="clModalDocTipo" class="sn-select">
              <option value="RUC">RUC (10 / 20)</option>
              <option value="DNI">DNI (Persona Natural)</option>
            </select>
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="clModalDoc">N° Documento *</label>
            <input type="text" id="clModalDoc" class="sn-input" placeholder="20554897123" required />
          </div>
        </div>

        <div class="sn-form-group">
          <label class="sn-label" for="clModalNombre">Razón Social o Nombre Completo *</label>
          <input type="text" id="clModalNombre" class="sn-input" placeholder="Ej. Restaurante El Buen Sabor S.A.C." required />
        </div>

        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="clModalRegimen">Régimen Tributario</label>
            <select id="clModalRegimen" class="sn-select">
              <option value="Régimen MYPE Tributario (RMT)">Régimen MYPE Tributario (RMT)</option>
              <option value="Régimen Especial de Renta (RER)">Régimen Especial de Renta (RER)</option>
              <option value="Régimen General">Régimen General</option>
              <option value="4ta Categoría (Recibos por Honorarios)">4ta Categoría (Recibos por Honorarios)</option>
            </select>
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="clModalHonorario">Honorario Mensual (S/)</label>
            <input type="number" step="0.01" id="clModalHonorario" class="sn-input" value="150.00" />
          </div>
        </div>

        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="clModalCelular">Celular WhatsApp *</label>
            <input type="tel" id="clModalCelular" class="sn-input" placeholder="961229280" required />
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="clModalEmail">Correo Electrónico</label>
            <input type="email" id="clModalEmail" class="sn-input" placeholder="contacto@empresa.com" />
          </div>
        </div>

        <div class="sn-form-group">
          <label class="sn-label" for="clModalDireccion">Dirección Fiscal</label>
          <input type="text" id="clModalDireccion" class="sn-input" placeholder="Av. Angamos Este 1240, Surquillo" />
        </div>

        <div class="cl-modal-actions">
          <button type="submit" class="ps-btn ps-btn-primary" id="btnModalGuardar">
            <i class="fa-solid fa-check"></i> Registrar en Cartera
          </button>
        </div>
      </form>
    </div>
  </div>

</section>

<script>
  import { inicializarModuloClientes } from './clientes.js';
  inicializarModuloClientes();
  document.addEventListener('astro:page-load', inicializarModuloClientes);
</script>
