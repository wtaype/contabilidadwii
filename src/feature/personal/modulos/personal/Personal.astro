---
// src/feature/personal/modulos/personal/Personal.astro
// Módulo de Personal: Equipo Profesional & Especialistas Contables (Estudio Cusihuaman)
// 100% JS Nativo · Integrado con @widev y Firestore ('personal') · 0 CSS Inline

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-personal" data-personal-init="false">
  
  <!-- CABECERA SUPERIOR STICKY -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-user-tie sn-header-icon" style="color: var(--brand-primary, var(--mco, #9e7b4f));"></i>
        Equipo Profesional & Especialistas Contables
      </h1>
      <p class="ps-section-sub">
        Gestión de contadores públicos colegiados, asistentes tributarios y soporte técnico del estudio.
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-primary" id="btnNuevoPersonal">
        <i class="fa-solid fa-user-plus"></i> Registrar Especialista
      </button>
    </div>
  </div>

  <!-- KPIS SUPERIORES -->
  <div class="pe-kpi-grid">
    <div class="pe-kpi-card">
      <div class="pe-kpi-icon-wrap">
        <i class="fa-solid fa-users"></i>
      </div>
      <div class="pe-kpi-data">
        <span class="pe-kpi-val" id="peKpiTotal">0</span>
        <span class="pe-kpi-lbl">Total Especialistas</span>
      </div>
    </div>

    <div class="pe-kpi-card">
      <div class="pe-kpi-icon-wrap pe-kpi-icon-amber">
        <i class="fa-solid fa-award"></i>
      </div>
      <div class="pe-kpi-data">
        <span class="pe-kpi-val" id="peKpiColegiados">0</span>
        <span class="pe-kpi-lbl">Colegiados y Habilitados</span>
      </div>
    </div>

    <div class="pe-kpi-card">
      <div class="pe-kpi-icon-wrap pe-kpi-icon-green">
        <i class="fa-solid fa-laptop-code"></i>
      </div>
      <div class="pe-kpi-data">
        <span class="pe-kpi-val" id="peKpiAsistentes">0</span>
        <span class="pe-kpi-lbl">Asistentes Contables & TI</span>
      </div>
    </div>

    <div class="pe-kpi-card">
      <div class="pe-kpi-icon-wrap pe-kpi-icon-blue">
        <i class="fa-solid fa-calendar-star"></i>
      </div>
      <div class="pe-kpi-data">
        <span class="pe-kpi-val" id="peKpiTrayectoria">17+ años</span>
        <span class="pe-kpi-lbl">Experiencia Combinada</span>
      </div>
    </div>
  </div>

  <!-- GRID DE TARJETAS DE ESPECIALISTAS -->
  <div class="pe-drivers-grid" id="peDriversGrid">
    <!-- Render dinámico desde personalMod.js -->
  </div>

  <!-- MODAL: REGISTRAR NUEVO ESPECIALISTA -->
  <div class="cl-modal-overlay" id="peModalOverlay">
    <div class="cl-modal">
      <div class="cl-modal-head">
        <h3 class="cl-modal-title">
          <i class="fa-solid fa-user-plus sn-title-icon"></i> Registrar Especialista en el Estudio
        </h3>
        <button type="button" class="cl-modal-close" id="btnPeModalClose">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <form id="formPePersonal" class="cl-modal-form">
        <div class="sn-form-group">
          <label class="sn-label" for="peModalNombre">Nombres y Apellidos *</label>
          <input type="text" id="peModalNombre" class="sn-input" placeholder="Ej. CPC Lourdes Cusihuaman" required />
        </div>

        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="peModalCargo">Cargo Oficial</label>
            <input type="text" id="peModalCargo" class="sn-input" placeholder="Contador Público Colegiado" />
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="peModalColegiatura">Colegiatura / Estado</label>
            <input type="text" id="peModalColegiatura" class="sn-input" placeholder="Colegiada y Habilitada" />
          </div>
        </div>

        <div class="sn-form-group">
          <label class="sn-label" for="peModalEspecialidad">Especialidad Tributaria</label>
          <input type="text" id="peModalEspecialidad" class="sn-input" placeholder="Ex-orientadora SUNAT · Rentas 4ta/5ta · MYPE" />
        </div>

        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="peModalCelular">Celular WhatsApp *</label>
            <input type="tel" id="peModalCelular" class="sn-input" placeholder="+51 987 594 558" required />
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="peModalEmail">Correo Electrónico</label>
            <input type="email" id="peModalEmail" class="sn-input" placeholder="contacto@contabilidadwii.com" />
          </div>
        </div>

        <div class="cl-modal-row">
          <div class="sn-form-group">
            <label class="sn-label" for="peModalModalidad">Modalidad de Atención</label>
            <select id="peModalModalidad" class="sn-select">
              <option value="Online & Presencial Surquillo">Online & Presencial Surquillo</option>
              <option value="100% Online Nacional">100% Online Nacional</option>
              <option value="Presencial Surquillo">Presencial Surquillo</option>
            </select>
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="peModalExperiencia">Años de Trayectoria</label>
            <input type="text" id="peModalExperiencia" class="sn-input" placeholder="12+ años de trayectoria" />
          </div>
        </div>

        <div class="cl-modal-actions">
          <button type="submit" class="ps-btn ps-btn-primary" id="btnPeModalGuardar">
            <i class="fa-solid fa-check"></i> Guardar Especialista
          </button>
        </div>
      </form>
    </div>
  </div>

</section>

<script>
  import { inicializarModuloPersonal } from './personalMod.js';
  inicializarModuloPersonal();
  document.addEventListener('astro:page-load', inicializarModuloPersonal);
</script>
