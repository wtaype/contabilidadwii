---
// src/feature/personal/modulos/productos/Productos.astro
// Módulo: Catálogo de Servicios & Asesorías Contables (Estudio Cusihuaman)
// División inteligente en Servicios Mensuales y Asesorías Puntuales · 100% Firestore + witema.css
interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-productos">
  <!-- Encabezado de Sección -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-scale-balanced sn-header-icon"></i>
        Servicios & Asesorías Contables
      </h1>
      <p class="ps-section-sub">
        Gestión de planes mensuales para empresas MYPE y asesorías tributarias individuales. Conectado a Firestore y reflejo en la Web Pública.
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-secondary" id="prBtnSincronizar" title="Sincronizar con Firestore">
        <i class="fa-solid fa-rotate"></i> Sincronizar
      </button>
      <button type="button" class="ps-btn ps-btn-primary" id="prBtnNuevo">
        <i class="fa-solid fa-plus"></i> Nuevo Servicio / Asesoría
      </button>
    </div>
  </div>

  <div class="pr-container">
    
    <!-- 1. Barra de Métricas del Catálogo -->
    <div class="pr-metrics-grid">
      <div class="pr-metric-card">
        <div class="pr-metric-icon total">
          <i class="fa-solid fa-briefcase"></i>
        </div>
        <div class="pr-metric-info">
          <span class="pr-metric-num" id="prStatTotal">0</span>
          <span class="pr-metric-label">Total en Catálogo</span>
        </div>
      </div>

      <div class="pr-metric-card">
        <div class="pr-metric-icon active">
          <i class="fa-solid fa-building-circle-check"></i>
        </div>
        <div class="pr-metric-info">
          <span class="pr-metric-num" id="prStatServicios">0</span>
          <span class="pr-metric-label">Servicios Mensuales</span>
        </div>
      </div>

      <div class="pr-metric-card">
        <div class="pr-metric-icon alert">
          <i class="fa-solid fa-comments"></i>
        </div>
        <div class="pr-metric-info">
          <span class="pr-metric-num" id="prStatAsesorias">0</span>
          <span class="pr-metric-label">Asesorías Puntuales</span>
        </div>
      </div>
    </div>

    <!-- 2. Toolbar: Filtros de Tipo y Buscador -->
    <div class="pr-toolbar">
      <div class="pr-filters-group" id="prFiltrosGroup">
        <button type="button" class="pr-filter-pill active" data-categoria="todos">
          <i class="fa-solid fa-layer-group"></i> Todos
        </button>
        <button type="button" class="pr-filter-pill" data-categoria="servicio">
          <i class="fa-solid fa-calendar-check"></i> Servicios Mensuales (MYPE)
        </button>
        <button type="button" class="pr-filter-pill" data-categoria="asesoria">
          <i class="fa-solid fa-user-clock"></i> Asesorías Puntuales (1h / Trámite)
        </button>
      </div>

      <div class="pr-actions-group">
        <div class="pr-search-box">
          <i class="fa-solid fa-magnifying-glass pr-search-icon"></i>
          <input
            type="search"
            id="prInputBuscar"
            class="pr-search-input"
            placeholder="Buscar por nombre, régimen o enfoque..."
          />
        </div>
      </div>
    </div>

    <!-- 3. Grid Dinámico de Tarjetas -->
    <div class="pr-grid" id="prGridProductos">
      <!-- Inyectado por productos.js desde Firestore / Caché -->
    </div>

    <!-- 4. Estado Vacío (Zero Data) -->
    <div class="pr-empty-box" id="prEmptyState" style="display: none;">
      <div class="pr-empty-icon">
        <i class="fa-solid fa-folder-open"></i>
      </div>
      <h3 class="pr-empty-title">No hay servicios registrados en esta categoría</h3>
      <p class="pr-empty-desc">
        Aún no tienes servicios o asesorías registradas. Haz clic en el botón para crear el primero o sincronizar desde semillas.
      </p>
      <button type="button" class="ps-btn ps-btn-primary" id="prBtnCrearPrimero">
        <i class="fa-solid fa-plus"></i> Crear Primer Servicio
      </button>
    </div>

  </div>
</section>

<!-- 5. Modal Bilingüe de Creación / Edición (Split 2 Columnas) -->
<div class="modal-overlay modal pr-modal-backdrop" id="prModalBackdrop">
  <div class="pr-modal-dialog">
    <header class="pr-modal-header">
      <h2 class="pr-modal-title" id="prModalTitle">
        <i class="fa-solid fa-pen-to-square"></i> Ficha de Servicio / Asesoría
      </h2>
      <button type="button" class="modal-close-btn pr-modal-close" id="prBtnCerrarModal" data-modal-close title="Cerrar ventana">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </header>

    <form id="prFormProducto" class="pr-modal-body-split">
      <input type="hidden" id="prFormId" />

      <!-- ── COLUMNA IZQUIERDA: COMERCIAL, FOTO Y PARÁMETROS BASE ── -->
      <div class="pr-col-comercial">
        <!-- Vista previa de imagen -->
        <div class="pr-modal-preview-box">
          <img id="prModalPreviewImg" src="/imgwii/servicios/servicio01.webp" alt="Vista previa del servicio" class="pr-modal-preview-img" />
          <div id="prModalPreviewEmpty" class="pr-modal-preview-empty" style="display: none;">
            <i class="fa-solid fa-image"></i>
            <span>Sin imagen cargada</span>
          </div>
        </div>

        <div class="pr-f-field">
          <label class="pr-f-label" for="prFormImagen">Ruta de Imagen (Local o WebP)</label>
          <input type="text" id="prFormImagen" class="pr-f-input" placeholder="/imgwii/servicios/servicio01.webp" />
          <span class="pr-f-help">Disponibles: /imgwii/servicios/servicio01.webp a servicio06.webp</span>
        </div>

        <div class="pr-f-grid-2">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormCategoria">Tipo de Oferta *</label>
            <select id="prFormCategoria" class="pr-f-select" required>
              <option value="servicio">Servicio Mensual (MYPE)</option>
              <option value="asesoria">Asesoría Puntual (1 a 1)</option>
            </select>
          </div>
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormEstado">Estado</label>
            <select id="prFormEstado" class="pr-f-select">
              <option value="activo">Activo (Visible en Web)</option>
              <option value="pausado">Pausado (Oculto)</option>
            </select>
          </div>
        </div>

        <div class="pr-f-grid-2">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormPrecio">Honorario / Precio (S/) *</label>
            <input type="number" id="prFormPrecio" class="pr-f-input" step="1" min="0" placeholder="150" required />
          </div>
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormOrden">Orden de Aparición</label>
            <input type="number" id="prFormOrden" class="pr-f-input" min="1" placeholder="1" />
          </div>
        </div>

        <div class="pr-f-field">
          <label class="pr-f-label" for="prFormEnfoque">Enfoque / Especialidad Principal</label>
          <input type="text" id="prFormEnfoque" class="pr-f-input" placeholder="Ej: Contabilidad MYPE y Régimen Especial" />
        </div>

        <div class="pr-f-grid-2">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormBadgeEs">Badge Destacado (ES)</label>
            <input type="text" id="prFormBadgeEs" class="pr-f-input" placeholder="Más Solicitado / Recomendado" />
          </div>
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormTagClase">Estilo Visual Badge</label>
            <select id="prFormTagClase" class="pr-f-select">
              <option value="badge-serenidad">Serenidad (Bronce / Oro)</option>
              <option value="badge-azul">Azul Profesional</option>
              <option value="badge-verde">Verde Éxito</option>
            </select>
          </div>
        </div>
      </div>

      <!-- ── COLUMNA DERECHA: TEXTOS Y BENEFICIOS BILINGÜES ── -->
      <div class="pr-col-ficha">
        <div class="pr-modal-tabs">
          <button type="button" class="pr-modal-tab-btn active" data-target="pane-es">
            <i class="fa-solid fa-language"></i> Español [ES]
          </button>
          <button type="button" class="pr-modal-tab-btn" data-target="pane-en">
            <i class="fa-solid fa-globe"></i> English [EN]
          </button>
        </div>

        <!-- PESTAÑA ESPAÑOL -->
        <div class="pr-lang-pane active" id="pane-es">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormNombreEs">Nombre Oficial del Servicio (ES) *</label>
            <input type="text" id="prFormNombreEs" class="pr-f-input" placeholder="Ej: Contabilidad Mensual para Tu Negocio (MYPE)" required />
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormDescEs">Descripción Detallada (ES) *</label>
            <textarea id="prFormDescEs" class="pr-f-textarea" rows="3" placeholder="Explicación clara de lo que incluye el servicio y el beneficio para el cliente..." required></textarea>
          </div>

          <div class="pr-f-grid-2">
            <div class="pr-f-field">
              <label class="pr-f-label" for="prFormDuracionEs">Periodicidad / Duración (ES)</label>
              <input type="text" id="prFormDuracionEs" class="pr-f-input" placeholder="Mensual / 1 Hora / Por Trámite" />
            </div>
            <div class="pr-f-field">
              <label class="pr-f-label" for="prFormModalidadEs">Modalidad de Atención (ES)</label>
              <input type="text" id="prFormModalidadEs" class="pr-f-input" placeholder="100% Online y Presencial en Surquillo previa cita" />
            </div>
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormPublicoEs">Público / Dirigido a (ES)</label>
            <input type="text" id="prFormPublicoEs" class="pr-f-input" placeholder="Pequeños Negocios, Bodegas y Emprendedores" />
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormGarantiasEs">Puntos Clave / Lo que incluye (Una línea por beneficio)</label>
            <textarea id="prFormGarantiasEs" class="pr-f-textarea" rows="3" placeholder="Liquidación puntual de IGV y Renta mensual&#10;Registro de compras y ventas en el sistema SIRE de SUNAT&#10;Tranquilidad total para que te dediques a vender"></textarea>
          </div>
        </div>

        <!-- PESTAÑA INGLÉS -->
        <div class="pr-lang-pane" id="pane-en">
          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormNombreEn">Service Name (EN)</label>
            <input type="text" id="prFormNombreEn" class="pr-f-input" placeholder="Ex: Monthly Accounting for Small Business (MYPE)" />
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormDescEn">Description (EN)</label>
            <textarea id="prFormDescEn" class="pr-f-textarea" rows="3" placeholder="Clear explanation of the accounting service in English..."></textarea>
          </div>

          <div class="pr-f-grid-2">
            <div class="pr-f-field">
              <label class="pr-f-label" for="prFormDuracionEn">Duration / Frequency (EN)</label>
              <input type="text" id="prFormDuracionEn" class="pr-f-input" placeholder="Monthly / 1 Hour / Per Procedure" />
            </div>
            <div class="pr-f-field">
              <label class="pr-f-label" for="prFormModalidadEn">Modality (EN)</label>
              <input type="text" id="prFormModalidadEn" class="pr-f-input" placeholder="100% Online & In-Person in Surquillo" />
            </div>
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormPublicoEn">Target Audience (EN)</label>
            <input type="text" id="prFormPublicoEn" class="pr-f-input" placeholder="Small Businesses & Independent Professionals" />
          </div>

          <div class="pr-f-field">
            <label class="pr-f-label" for="prFormGarantiasEn">Key Inclusions (One line per bullet point)</label>
            <textarea id="prFormGarantiasEn" class="pr-f-textarea" rows="3" placeholder="Timely monthly IGV and Income Tax filing&#10;Sales and purchase recording in SUNAT SIRE system&#10;Total peace of mind"></textarea>
          </div>
        </div>
      </div>
    </form>

    <footer class="pr-modal-footer">
      <div class="pr-modal-footer-info">
        <i class="fa-solid fa-cloud-arrow-up"></i> Conectado con Firestore en tiempo real & Re-Deploy
      </div>
      <div class="pr-modal-footer-actions">
        <button type="button" class="ps-btn ps-btn-secondary modal-close-btn" id="prBtnCancelarModal" data-modal-close>
          Cancelar
        </button>
        <button type="submit" form="prFormProducto" class="ps-btn ps-btn-primary" id="prBtnGuardarModal">
          <i class="fa-solid fa-floppy-disk"></i> Guardar en Catálogo
        </button>
      </div>
    </footer>
  </div>
</div>

<script>
  import './productos.js';
</script>
