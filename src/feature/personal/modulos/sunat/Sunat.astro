---
// src/feature/personal/modulos/sunat/Sunat.astro
// Módulo de SUNAT: Facturación Electrónica & Comprobantes (Estudio Cusihuaman)
// 100% JS Nativo · Integrado con @widev, Firestore y comprobantes contables B001 / F001

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-sunat" data-sunat-init="false">
  
  <!-- CABECERA SUPERIOR DE SECCIÓN -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-solid fa-file-invoice-dollar sn-header-icon"></i>
        SUNAT · Facturación & Comprobantes Contables
      </h1>
      <p class="ps-section-sub">
        Emisión ágil de Boletas (B001) y Facturas (F001) electrónicas por honorarios, contabilidad mensual MYPE y asesorías tributarias.
      </p>
    </div>
    <div class="ps-header-actions">
      <button type="button" class="ps-btn ps-btn-secondary" id="btnSunatNuevaBoleta">
        <i class="fa-solid fa-receipt"></i> Nueva Boleta (B001)
      </button>
      <button type="button" class="ps-btn ps-btn-secondary" id="btnSunatNuevaFactura">
        <i class="fa-solid fa-building"></i> Nueva Factura (F001)
      </button>
      <button type="button" class="cr-btn-send" id="btnRegistrarComprobante">
        <i class="fa-solid fa-cloud-arrow-up"></i> Emitir Comprobante
      </button>
    </div>
  </div>

  <!-- RESUMEN EN KPIS SUPERIORES -->
  <div class="sn-kpi-grid">
    <div class="sn-kpi-card">
      <div class="sn-kpi-icon-wrap">
        <i class="fa-solid fa-sack-dollar"></i>
      </div>
      <div class="sn-kpi-data">
        <span class="sn-kpi-val" id="snKpiTotalMes">S/ 0.00</span>
        <span class="sn-kpi-lbl">Total Facturado Reciente</span>
      </div>
    </div>

    <div class="sn-kpi-card">
      <div class="sn-kpi-icon-wrap sn-kpi-icon-blue">
        <i class="fa-solid fa-receipt"></i>
      </div>
      <div class="sn-kpi-data">
        <span class="sn-kpi-val" id="snKpiBoletas">0</span>
        <span class="sn-kpi-lbl">Boletas Emitidas (B001)</span>
      </div>
    </div>

    <div class="sn-kpi-card">
      <div class="sn-kpi-icon-wrap sn-kpi-icon-purple">
        <i class="fa-solid fa-building"></i>
      </div>
      <div class="sn-kpi-data">
        <span class="sn-kpi-val" id="snKpiFacturas">0</span>
        <span class="sn-kpi-lbl">Facturas Emitidas (F001)</span>
      </div>
    </div>

    <div class="sn-kpi-card">
      <div class="sn-kpi-icon-wrap sn-kpi-icon-green">
        <i class="fa-solid fa-handshake-simple"></i>
      </div>
      <div class="sn-kpi-data">
        <span class="sn-kpi-val" id="snKpiClientes">0</span>
        <span class="sn-kpi-lbl">Clientes Atendidos</span>
      </div>
    </div>
  </div>

  <!-- LAYOUT PRINCIPAL: REDACTOR (IZQ) Y TICKET TÉRMICO SUNAT (DER) -->
  <div class="sn-main-layout">
    
    <!-- COLUMNA 1: FORMULARIO REDACTOR INTELIGENTE -->
    <div class="sn-composer-card">
      <form id="formSunatComprobante" autocomplete="off">
        
        <!-- Fila 1: Tipo de Comprobante y Serie -->
        <div class="sn-form-row">
          <div class="sn-form-group">
            <label class="sn-label" for="snSelectTipoDoc">Tipo de Comprobante *</label>
            <select id="snSelectTipoDoc" class="sn-select" required>
              <option value="boleta">Boleta de Venta Electrónica (B001)</option>
              <option value="factura">Factura Comercial Electrónica (F001)</option>
            </select>
          </div>

          <div class="sn-form-group">
            <label class="sn-label" for="snInpSerieNumero">Serie y Número Correlativo</label>
            <input type="text" id="snInpSerieNumero" class="sn-input is-readonly" value="B001-000101" readonly />
          </div>

          <div class="sn-form-group">
            <label class="sn-label" for="snInpFechaEmision">Fecha de Emisión</label>
            <input type="text" id="snInpFechaEmision" class="sn-input is-readonly" value="Hoy" readonly />
          </div>
        </div>

        <!-- Fila 2: Autocompletado de Cliente Contable -->
        <div class="sn-form-group sn-mt-14">
          <label class="sn-label" for="snInpClienteBuscar">
            <i class="fa-solid fa-magnifying-glass"></i> Cliente / Razón Social *
            <span class="sn-label-hint">Autocompletado con directorio de clientes o nuevos</span>
          </label>
          <div class="sn-autocomplete-wrap">
            <input 
              type="text" 
              id="snInpClienteBuscar" 
              class="sn-input sn-input-lg" 
              placeholder="Buscar por RUC, DNI o Nombre de empresa..." 
              required 
            />
            <div class="sn-sugerencias-dropdown" id="snDropdownClientes" style="display: none;"></div>
          </div>
        </div>

        <!-- Fila 3: Documento (DNI/RUC) y Celular de WhatsApp -->
        <div class="sn-form-row sn-mt-10">
          <div class="sn-form-group">
            <label class="sn-label" for="snSelectDocTipo">Tipo Doc.</label>
            <select id="snSelectDocTipo" class="sn-select">
              <option value="DNI">DNI (8 dígitos)</option>
              <option value="RUC">RUC (11 dígitos)</option>
              <option value="CE">Carnet de Extranjería</option>
            </select>
          </div>

          <div class="sn-form-group">
            <label class="sn-label" for="snInpDocNumero">Número de Documento *</label>
            <input type="text" id="snInpDocNumero" class="sn-input" placeholder="Ej: 20554897123" required />
          </div>

          <div class="sn-form-group">
            <label class="sn-label" for="snInpClienteCelular">Celular WhatsApp</label>
            <input type="tel" id="snInpClienteCelular" class="sn-input" placeholder="Ej: 987654321" />
          </div>
        </div>

        <!-- Fila 4: Dirección / Domicilio Fiscal -->
        <div class="sn-form-group sn-mt-10">
          <label class="sn-label" for="snInpClienteDireccion">Domicilio Fiscal / Dirección</label>
          <input type="text" id="snInpClienteDireccion" class="sn-input" placeholder="Ej: Av. Angamos Este 1240, Surquillo, Lima" />
        </div>

        <!-- SECCIÓN DE SELECCIÓN RÁPIDA DE SERVICIOS CONTABLES -->
        <div class="sn-quick-prods-wrap">
          <div class="sn-quick-title">
            <i class="fa-solid fa-scale-balanced"></i> Añadir Servicio Contable con 1 Clic
          </div>
          <div class="sn-quick-buttons" id="snQuickButtonsWrap">
            <button type="button" class="sn-quick-btn" data-prod-id="contabilidad-mensual-mype" data-prod-desc="Servicio Contable Mensual MYPE & SIRE" data-prod-price="150.00">
              💼 Contabilidad MYPE <span class="price-tag">S/ 150.00</span>
            </button>
            <button type="button" class="sn-quick-btn" data-prod-id="asesoria-orientacion-tributaria" data-prod-desc="Asesoría y Orientación Tributaria Personalizada (1 Hora)" data-prod-price="80.00">
              ⚖️ Asesoría 1 Hora <span class="price-tag">S/ 80.00</span>
            </button>
            <button type="button" class="sn-quick-btn" data-prod-id="planillas-quinta-categoria" data-prod-desc="Cálculo de Planillas de Trabajadores y Plame (5ta Cat)" data-prod-price="180.00">
              📋 Planillas 5ta <span class="price-tag">S/ 180.00</span>
            </button>
            <button type="button" class="sn-quick-btn" data-prod-id="regularizacion-multas-sunat" data-prod-desc="Regularización de Infracción y Subsanación Voluntaria SUNAT" data-prod-price="120.00">
              📑 Regularización RUC <span class="price-tag">S/ 120.00</span>
            </button>
            <button type="button" class="sn-quick-btn" data-prod-id="recibos-por-honorarios-cuarta" data-prod-desc="Declaración y Trámite Formulario 1609 (4ta Cat RHE)" data-prod-price="60.00">
              📄 Declaración RHE <span class="price-tag">S/ 60.00</span>
            </button>
          </div>
        </div>

        <!-- TABLA DE DETALLE DE ÍTEMS -->
        <div class="sn-items-table-wrap">
          <table class="sn-items-table">
            <thead>
              <tr>
                <th class="sn-col-desc">Descripción del Servicio / Asesoría</th>
                <th class="sn-col-qty">Cant.</th>
                <th class="sn-col-price">P. Unit. (S/)</th>
                <th class="sn-col-total">Total (S/)</th>
                <th class="sn-col-action"></th>
              </tr>
            </thead>
            <tbody id="snItemsTableBody">
              <!-- Render dinámico -->
            </tbody>
          </table>
        </div>

        <!-- RESUMEN DE TOTALES -->
        <div class="sn-totals-box">
          <div class="sn-total-row">
            <span>Operación Gravada (Base imponible):</span>
            <span id="snTxtOpGravada">S/ 0.00</span>
          </div>
          <div class="sn-total-row">
            <span>I.G.V. (18.00%):</span>
            <span id="snTxtIgv">S/ 0.00</span>
          </div>
          <div class="sn-total-row highlight">
            <span>Importe Total a Cobrar:</span>
            <span class="amount" id="snTxtTotal">S/ 0.00</span>
          </div>
        </div>

        <!-- Fila 5: Forma de Pago y Estado -->
        <div class="sn-form-row sn-mt-14">
          <div class="sn-form-group">
            <label class="sn-label" for="snSelectMetodoPago">Medio de Pago</label>
            <select id="snSelectMetodoPago" class="sn-select">
              <option value="Transferencia BCP">Transferencia BCP</option>
              <option value="Yape / Plin">Yape / Plin</option>
              <option value="Transferencia BBVA">Transferencia BBVA</option>
              <option value="Efectivo en oficina">Efectivo en oficina</option>
            </select>
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="snSelectEstado">Estado de Pago</label>
            <select id="snSelectEstado" class="sn-select">
              <option value="pagado">Pagado (Conforme)</option>
              <option value="pendiente">Pendiente de transferencia</option>
            </select>
          </div>
        </div>

        <div class="sn-form-group sn-mt-10">
          <label class="sn-label" for="snInpObservacion">Observación Contable</label>
          <input type="text" id="snInpObservacion" class="sn-input" placeholder="Ej: Periodo tributario Septiembre 2026. Declaración SIRE conforme." />
        </div>
      </form>
    </div>

    <!-- COLUMNA 2: TICKET TÉRMICO EN VIVO (SUNAT OFICIAL) -->
    <div class="sn-ticket-wrap">
      <div class="sn-ticket-card" id="snTicketPreviewCard">
        <div class="sn-ticket-header">
          <div class="sn-ticket-brand">ESTUDIO CUSIHUAMAN</div>
          <div class="sn-ticket-sub">CPC Lourdes Cusihuaman Gálvez</div>
          <div class="sn-ticket-ruc">RUC: 10478912345</div>
          <div class="sn-ticket-address">Jr. Dante 260, Surquillo, Lima 15047</div>
          <div class="sn-ticket-address">Telf / WhatsApp: +51 987 594 558</div>
          <div class="sn-ticket-type" id="snTicketTipoBadge">BOLETA DE VENTA ELECTRÓNICA</div>
          <div class="sn-ticket-number" id="snTicketSerieNumero">B001-000101</div>
        </div>

        <div class="sn-ticket-divider">--------------------------------</div>

        <div class="sn-ticket-info-grid">
          <div class="sn-ti-row">
            <span class="sn-ti-k">Fecha:</span>
            <span class="sn-ti-v" id="snTicketFecha">Hoy</span>
          </div>
          <div class="sn-ti-row">
            <span class="sn-ti-k">Cliente:</span>
            <span class="sn-ti-v" id="snTicketCliente">Cliente General</span>
          </div>
          <div class="sn-ti-row">
            <span class="sn-ti-k" id="snTicketDocLbl">Doc:</span>
            <span class="sn-ti-v" id="snTicketDocVal">--------</span>
          </div>
          <div class="sn-ti-row">
            <span class="sn-ti-k">Dirección:</span>
            <span class="sn-ti-v" id="snTicketDir">Surquillo / Lima</span>
          </div>
        </div>

        <div class="sn-ticket-divider">--------------------------------</div>

        <!-- ITEMS TICKET -->
        <div class="sn-ticket-items" id="snTicketItemsList">
          <!-- Render dinámico -->
        </div>

        <div class="sn-ticket-divider">--------------------------------</div>

        <div class="sn-ticket-totals">
          <div class="sn-tt-row">
            <span>OP. GRAVADA:</span>
            <span id="snTicketOpGravada">S/ 0.00</span>
          </div>
          <div class="sn-tt-row">
            <span>I.G.V. (18%):</span>
            <span id="snTicketIgv">S/ 0.00</span>
          </div>
          <div class="sn-tt-row total">
            <span>TOTAL A PAGAR:</span>
            <span id="snTicketTotal">S/ 0.00</span>
          </div>
        </div>

        <div class="sn-ticket-divider">--------------------------------</div>

        <div class="sn-ticket-footer">
          <div class="sn-tf-obs" id="snTicketObs">Servicio contable y tributario prestado conforme a Ley.</div>
          <div class="sn-tf-auth">Representación Impresa del Comprobante de Pago Electrónico</div>
          <div class="sn-tf-auth">
            <strong>Asesoría Contable Profesional y Confiable</strong>
          </div>
        </div>
      </div>

      <!-- BOTONES DE ACCIÓN DEL TICKET -->
      <div class="sn-ticket-actions">
        <button type="button" class="sn-ticket-btn" id="btnImprimirTicket">
          <i class="fa-solid fa-print"></i> Imprimir Comprobante
        </button>
        <button type="button" class="sn-ticket-btn sn-ticket-btn-wa" id="btnEnviarWhatsAppTicket">
          <i class="fa-brands fa-whatsapp"></i> Enviar Comprobante por WhatsApp
        </button>
      </div>
    </div>

  </div>

  <!-- SECCIÓN HISTORIAL DE COMPROBANTES EMITIDOS RECIENTES -->
  <div class="sn-history-section sn-mt-24">
    <div class="sn-history-header">
      <div class="sn-history-title-wrap">
        <h2 class="sn-history-title">
          <i class="fa-solid fa-clock-rotate-left"></i> Historial Reciente de Comprobantes
        </h2>
        <span class="sn-history-sub">Registro Local-First sincronizado con Firestore</span>
      </div>
      <div class="sn-history-tools">
        <button type="button" class="ps-btn ps-btn-secondary" id="btnExportarCsvSunat">
          <i class="fa-solid fa-file-csv"></i> Exportar Registro Contable
        </button>
      </div>
    </div>

    <div class="sn-table-responsive">
      <table class="sn-data-table">
        <thead>
          <tr>
            <th>Serie / N°</th>
            <th>Tipo</th>
            <th>Fecha y Hora</th>
            <th>Cliente / Razón Social</th>
            <th>RUC / DNI</th>
            <th>Total (S/)</th>
            <th>Medio Pago</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="snTableHistorialBody">
          <!-- Inyectado por sunat.js -->
        </tbody>
      </table>
    </div>
  </div>

</section>

<script>
  import './sunat.js';
</script>
