---
// src/feature/personal/modulos/whatsapp/Whatsapp.astro
// Módulo de WhatsApp: Centro de Mensajería & Sandbox Tributario (Estudio Cusihuaman)
// 100% JS Nativo · Integrado con @widev · 0 CSS Inline

interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-whatsapp" data-whatsapp-init="false">
  
  <!-- CABECERA SUPERIOR STICKY -->
  <div class="ps-section-header">
    <div class="ps-section-title-wrap">
      <h1 class="ps-section-title">
        <i class="fa-brands fa-whatsapp sn-header-icon" style="color: #25d366;"></i>
        WhatsApp · Centro de Mensajería Tributaria & Sandbox
      </h1>
      <p class="ps-section-sub">
        Plantillas profesionales de vencimientos SUNAT, liquidaciones con NPS y asesorías con simulador interactivo de smartphone en vivo.
      </p>
    </div>
  </div>

  <!-- LAYOUT DIVIDIDO (CONFIGURADOR 56% / SIMULADOR MÓVIL 44%) -->
  <div class="wa-split-layout">
    
    <!-- COLUMNA 1: CONFIGURADOR DE PLANTILLAS Y VARIABLES -->
    <div class="wa-card">
      <h2 class="wa-card-title">
        <i class="fa-solid fa-layer-group sn-title-icon"></i> 1. Selecciona la Plantilla Contable
      </h2>

      <!-- Grid de 6 Plantillas Maestras -->
      <div class="wa-templates-grid" id="waTemplatesGrid">
        <!-- Render dinámico desde whatsapp.js -->
      </div>

      <!-- Parámetros Dinámicos -->
      <div class="wa-params-box">
        <div class="wa-params-title">
          <i class="fa-solid fa-sliders"></i> 2. Personalizar Datos del Contribuyente y Declaración
        </div>

        <div class="wa-form-row">
          <div class="sn-form-group">
            <label class="sn-label" for="waInpCliente">Cliente / Razón Social</label>
            <input type="text" id="waInpCliente" class="sn-input" value="Inversiones Gastronómicas S.A.C." />
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="waInpCelular">Celular WhatsApp Destino</label>
            <input type="tel" id="waInpCelular" class="sn-input" value="961229280" placeholder="961229280" />
          </div>
        </div>

        <div class="wa-form-row">
          <div class="sn-form-group">
            <label class="sn-label" for="waInpRuc">RUC (10 / 20)</label>
            <input type="text" id="waInpRuc" class="sn-input" value="20554897123" />
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="waInpDigito">Último Dígito</label>
            <input type="text" id="waInpDigito" class="sn-input" value="3" />
          </div>
        </div>

        <div class="wa-form-row">
          <div class="sn-form-group">
            <label class="sn-label" for="waInpPeriodo">Período Fiscal</label>
            <input type="text" id="waInpPeriodo" class="sn-input" value="Agosto 2026" />
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="waInpMonto">Monto / Total Tributos (S/)</label>
            <input type="text" id="waInpMonto" class="sn-input" value="185.00" />
          </div>
        </div>

        <div class="wa-form-row">
          <div class="sn-form-group">
            <label class="sn-label" for="waInpNps">Código Pago NPS</label>
            <input type="text" id="waInpNps" class="sn-input" value="9827364510" />
          </div>
          <div class="sn-form-group">
            <label class="sn-label" for="waInpFechaVencimiento">Fecha Límite Vencimiento</label>
            <input type="text" id="waInpFechaVencimiento" class="sn-input" value="18 de Septiembre de 2026" />
          </div>
        </div>
      </div>

      <!-- Editor de Texto Final -->
      <div class="sn-form-group">
        <label class="sn-label" for="waTextareaMensaje">
          <i class="fa-solid fa-pen-to-square"></i> 3. Mensaje Final Formateado (Editable)
        </label>
        <textarea id="waTextareaMensaje" class="wa-textarea"></textarea>
      </div>
    </div>

    <!-- COLUMNA 2: SIMULADOR DE SMARTPHONE EN VIVO (SANDBOX) -->
    <div class="wa-phone-wrap">
      <div class="wa-phone-frame">
        <!-- Status Bar -->
        <div class="wa-phone-status-bar">
          <span id="waPhoneClock">9:41</span>
          <div>
            <i class="fa-solid fa-signal" style="margin-right: 4px;"></i>
            <i class="fa-solid fa-wifi" style="margin-right: 4px;"></i>
            <i class="fa-solid fa-battery-full"></i>
          </div>
        </div>

        <!-- Chat Header -->
        <div class="wa-chat-header">
          <div class="wa-chat-sender-info">
            <i class="fa-solid fa-arrow-left" style="color: #aebac1; font-size: 13px;"></i>
            <img src="/imgwii/logo.webp" alt="Estudio Cusihuaman" class="wa-chat-avatar" />
            <div class="wa-chat-sender-meta">
              <div class="wa-chat-sender-name">
                Estudio Cusihuaman
                <i class="fa-solid fa-circle-check wa-chat-verified-icon"></i>
              </div>
              <div class="wa-chat-sender-sub">CPC Lourdes Cusihuaman · Oficial</div>
            </div>
          </div>

          <div class="wa-chat-header-icons">
            <i class="fa-solid fa-video"></i>
            <i class="fa-solid fa-phone"></i>
            <i class="fa-solid fa-ellipsis-vertical"></i>
          </div>
        </div>

        <!-- Chat Body -->
        <div class="wa-chat-body">
          <div class="wa-chat-date-pill">Hoy</div>

          <div class="wa-chat-bubble-out">
            <div id="waChatBubbleText">Cargando mensaje...</div>
            <div class="wa-chat-bubble-meta">
              <span id="waChatTime">09:41</span>
              <i class="fa-solid fa-check-double wa-chat-ticks"></i>
            </div>
          </div>
        </div>

        <!-- Chat Footer -->
        <div class="wa-chat-footer">
          <i class="fa-regular fa-face-smile" style="color: #8696a0; font-size: 18px;"></i>
          <div class="wa-chat-input-fake">Mensaje tributario</div>
          <i class="fa-solid fa-paperclip" style="color: #8696a0; font-size: 16px;"></i>
          <div class="wa-chat-mic-btn">
            <i class="fa-solid fa-microphone"></i>
          </div>
        </div>
      </div>

      <!-- Acciones de Disparo Directo -->
      <div class="wa-sandbox-actions">
        <button type="button" class="wa-btn-open-ws" id="btnWaOpenWs">
          <i class="fa-brands fa-whatsapp"></i> Abrir en WhatsApp Web / Móvil
        </button>
        <button type="button" class="wa-btn-copy" id="btnWaCopy" title="Copiar mensaje">
          <i class="fa-solid fa-copy"></i> Copiar
        </button>
      </div>
    </div>

  </div>

</section>

<script>
  import { inicializarModuloWhatsapp } from './whatsapp.js';
  inicializarModuloWhatsapp();
  document.addEventListener('astro:page-load', inicializarModuloWhatsapp);
</script>
