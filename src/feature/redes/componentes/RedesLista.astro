---
// src/feature/redes/componentes/RedesLista.astro
// Contenedor y orquestador de botones de canales oficiales (100% Español, 0ms)
import RedesCard from './RedesCard.astro';
import { datosNegocio } from '../../../negocio.js';

const redes = datosNegocio.redes || {};
const wsNumero = datosNegocio.whatsappLimpio || datosNegocio.whatsapp || '';
const wsMensaje = datosNegocio.whatsappMensaje || '¡Hola! Te contacto desde tu página oficial de enlaces y redes.';
const wsUrl = wsNumero ? `https://wa.me/${wsNumero}?text=${encodeURIComponent(wsMensaje)}` : '';
const canalWhatsappHref = redes.canalWhatsapp || wsUrl;
const webUrl = redes.web || '/';

function normalizarUrlRed(urlOrHandle = '', tipo = '') {
  if (!urlOrHandle || typeof urlOrHandle !== 'string') return '';
  const val = urlOrHandle.trim();
  if (!val) return '';
  if (val.startsWith('http://') || val.startsWith('https://')) return val;

  const handle = val.replace(/^[@/]+/, '');
  switch (tipo) {
    case 'youtube': return `https://youtube.com/@${handle}`;
    case 'facebook': return `https://facebook.com/${handle}`;
    case 'instagram': return `https://instagram.com/${handle}`;
    case 'tiktok': return `https://tiktok.com/@${handle}`;
    case 'linkedin': return `https://linkedin.com/in/${handle}`;
    case 'web': return `https://${handle}`;
    default: return val;
  }
}

const ytUrl = normalizarUrlRed(redes.youtube || redes.youtubeUser, 'youtube');
const fbUrl = normalizarUrlRed(redes.facebook || redes.facebookUser, 'facebook');
const igUrl = normalizarUrlRed(redes.instagram || redes.instagramUser, 'instagram');
const ttUrl = normalizarUrlRed(redes.tiktok || redes.tiktokUser, 'tiktok');
const liUrl = normalizarUrlRed(redes.linkedin || redes.linkedinUser, 'linkedin');
const twUrl = normalizarUrlRed(redes.twitter || redes.twitterUser, 'twitter');
const wbUrl = normalizarUrlRed(redes.web || redes.webOficial || webUrl, 'web');

// Lista de canales oficiales con metadatos de alta conversión
const canales = [
  {
    id: 'linkedin',
    icono: 'fa-brands fa-linkedin-in',
    titulo: 'LinkedIn',
    subtitulo: 'Trayectoria y perfil profesional',
    badge: 'Profesional',
    href: liUrl,
    mostrar: Boolean(liUrl)
  },
  {
    id: 'web',
    icono: 'fa-solid fa-globe',
    titulo: 'Web Oficial',
    subtitulo: 'Portal corporativo y sedes',
    badge: 'Portal Web',
    href: wbUrl,
    target: wbUrl.startsWith('http') ? '_blank' : '_self',
    mostrar: Boolean(wbUrl && wbUrl !== '/')
  },
  {
    id: 'whatsapp',
    icono: 'fa-brands fa-whatsapp',
    titulo: 'WhatsApp',
    subtitulo: 'Atención directa y consultas',
    badge: 'Directo',
    href: canalWhatsappHref,
    dataNegocioWs: !redes.canalWhatsapp && Boolean(wsNumero),
    mostrar: Boolean(canalWhatsappHref)
  },
  {
    id: 'instagram',
    icono: 'fa-brands fa-instagram',
    titulo: 'Instagram',
    subtitulo: 'Historias, fotos y actualidad',
    badge: 'Social',
    href: igUrl,
    mostrar: Boolean(igUrl)
  },
  {
    id: 'facebook',
    icono: 'fa-brands fa-facebook-f',
    titulo: 'Facebook',
    subtitulo: 'Página oficial y comunidad',
    badge: 'Página',
    href: fbUrl,
    mostrar: Boolean(fbUrl)
  },
  {
    id: 'tiktok',
    icono: 'fa-brands fa-tiktok',
    titulo: 'TikTok',
    subtitulo: 'Videos informativos y tips',
    badge: 'Videos',
    href: ttUrl,
    mostrar: Boolean(ttUrl)
  },
  {
    id: 'youtube',
    icono: 'fa-brands fa-youtube',
    titulo: 'YouTube',
    subtitulo: 'Canal de contenido y tutoriales',
    badge: 'Canal',
    href: ytUrl,
    mostrar: Boolean(ytUrl)
  },
  {
    id: 'twitter',
    icono: 'fa-brands fa-x-twitter',
    titulo: 'X (Twitter)',
    subtitulo: 'Comunicados y noticias',
    badge: 'Oficial',
    href: twUrl,
    mostrar: Boolean(twUrl)
  }
];

// Orden dinámico configurable desde Firestore / semillas con fallback inteligente
const ordenPrioridad = (Array.isArray(datosNegocio.redesOrden) && datosNegocio.redesOrden.length > 0)
  ? datosNegocio.redesOrden
  : ['linkedin', 'web', 'whatsapp', 'instagram', 'facebook', 'tiktok', 'youtube', 'twitter'];

const canalesOrdenados = [...canales].sort((a, b) => {
  const idxA = ordenPrioridad.indexOf(a.id);
  const idxB = ordenPrioridad.indexOf(b.id);
  return (idxA === -1 ? 999 : idxA) - (idxB === -1 ? 999 : idxB);
});
---

<div class="redes-lista" role="navigation" aria-label="Enlaces oficiales">
  {canalesOrdenados.map((canal) => (
    <RedesCard
      href={canal.href || '#'}
      redId={canal.id}
      icono={canal.icono}
      titulo={canal.titulo}
      subtitulo={canal.subtitulo}
      badge={canal.badge}
      target={canal.target || '_blank'}
      dataNegocioWs={canal.dataNegocioWs}
      style={canal.mostrar ? undefined : "display: none;"}
    />
  ))}
</div>
